//! check: run(exit=0)

use std.fs

fn usage() -> !int {
    print("usage: tomlq [--json | --tagged] FILE|-")
    print("       tomlq [--raw] PATH FILE|-")
    print("       tomlq --keys PATH FILE|- | --len PATH FILE|-")
    print("       tomlq --spec DIR [--spec-verbose] [--only SUBDIR]")
    print("       tomlq --help")
    print("       tomlq --version")
    0
}

fn usage_err() -> !int {
    eprint("usage: tomlq [--json | --tagged] FILE|-\n")
    eprint("       tomlq [--raw] PATH FILE|-\n")
    eprint("       tomlq --keys PATH FILE|- | --len PATH FILE|-\n")
    eprint("       tomlq --spec DIR [--spec-verbose] [--only SUBDIR]\n")
    eprint("       tomlq --help\n")
    eprint("       tomlq --version\n")
    2
}

fn not_implemented() -> !int {
    eprint("tomlq: not implemented\n")
    2
}

/// Read a file and print its tokens.
fn tokens_file(path: str) -> !int {
    let text = fs.read_text(path) else |err| {
        eprint("tomlq: {path}: {err}\n")
        return 2
    }
    var c = cursor_init(text)
    while !cursor_at_end(c) {
        cursor_skip_ws_comment(mut c)?
        if cursor_at_end(c) {
            break
        }
        let ch = cursor_peek(c)
        if ch == "\"" || ch == "'" {
            let s = parse_string(mut c) else |err| {
                eprint("tomlq: {path}: {err}\n")
                return 2
            }
            print("STR {s}")
        } else if ch == "=" {
            cursor_advance(mut c)
            cursor_skip_ws_comment(mut c)?
            if cursor_at_end(c) {
                break
            }
            let kind = peek_value_kind(c)
            if kind == "string" {
                let v = parse_string(mut c) else |err| {
                    eprint("tomlq: {path}: {err}\n")
                    return 2
                }
                print("STR {v}")
            } else if kind == "integer" {
                let v = parse_integer(mut c) else |err| {
                    eprint("tomlq: {path}: {err}\n")
                    return 2
                }
                print("INT {v}")
            } else if kind == "float" {
                let v = parse_float(mut c) else |err| {
                    eprint("tomlq: {path}: {err}\n")
                    return 2
                }
                print("FLT {v}")
            } else if kind == "bool" {
                let v = parse_boolean(mut c) else |err| {
                    eprint("tomlq: {path}: {err}\n")
                    return 2
                }
                print("BOOL {v}")
            } else if kind == "datetime" {
                let v = parse_datetime(mut c) else |err| {
                    eprint("tomlq: {path}: {err}\n")
                    return 2
                }
                print("DATETIME {v}")
            } else if kind == "local-date" {
                let v = parse_local_date(mut c) else |err| {
                    eprint("tomlq: {path}: {err}\n")
                    return 2
                }
                print("LOCAL-DATE {v}")
            } else if kind == "local-time" {
                let v = parse_local_time(mut c) else |err| {
                    eprint("tomlq: {path}: {err}\n")
                    return 2
                }
                print("LOCAL-TIME {v}")
            } else {
                cursor_advance(mut c)
            }
        } else {
            cursor_advance(mut c)
        }
    }
    0
}

/// Read text from a file path, or stdin if path is "-".
fn read_input(path: str) -> str ! {ReadError(str)} {
    if path == "-" {
        fs.read_text("/dev/stdin") else |err| {
            return ReadError("{err}")
        }
    } else {
        fs.read_text(path) else |err| {
            let msg = "{err}"
            if msg.starts_with("not_found") {
                return ReadError("no such file")
            }
            return ReadError(msg)
        }
    }
}

/// Read a file and print its JSON.
fn json_file(path: str) -> !int {
    let text = read_input(path) else |ReadError(msg)| {
        eprint("tomlq: {path}: {msg}")
        return 2
    }
    var p = parser_init(text)
    let root = parse_document(mut p) else |e| match e {
        ParseError(l, c, m) => {
            eprint("tomlq: {path}:{l}:{c}: {m}\n")
            return 2
        },
    }
    let j = emit_json(p.arena, root) else |e| match e {
        ParseError(l, c, m) => {
            eprint("tomlq: {path}:{l}:{c}: {m}\n")
            return 2
        },
    }
    print(j)
    0
}

/// Read a file and print its tagged JSON.
fn tagged_file(path: str) -> !int {
    let text = read_input(path) else |ReadError(msg)| {
        eprint("tomlq: {path}: {msg}")
        return 2
    }
    var p = parser_init(text)
    let root = parse_document(mut p) else |e| match e {
        ParseError(l, c, m) => {
            eprint("tomlq: {path}:{l}:{c}: {m}\n")
            return 2
        },
    }
    let j = emit_tagged(p.arena, root) else |e| match e {
        ParseError(l, c, m) => {
            eprint("tomlq: {path}:{l}:{c}: {m}\n")
            return 2
        },
    }
    print(j)
    0
}

/// Navigate the arena tree by a dot-separated path. Returns the node index, or -1 if not found.
/// Handles leading ".", quoted segments (."a b"), and [N] indexes into arrays.
fn navigate_path(arena: List[Node], root: int, path: str) -> int {
    if path == "" {
        return root
    }
    var current = root
    var pos = 0
    // Skip leading "."
    if (path.get(0..1) else "") == "." {
        pos = 1
    }
    while pos < path.len {
        // Check for [N] index
        if (path.get(pos..pos + 1) else "") == "[" {
            // Parse index
            var end = pos + 1
            while end < path.len {
                let ch = path.get(end..end + 1) else ""
                if ch == "]" {
                    break
                }
                end = end + 1
            }
            let idx_str = path.get(pos + 1..end) else ""
            let idx = idx_str.to_int() else -1
            if idx < 0 {
                return -1
            }
            pos = end + 1
            // Index into array
            if node_kind(arena, current) != 1 {
                return -1
            }
            let nkids = node_kid_len(arena, current)
            if idx >= nkids {
                return -1
            }
            current = node_kid_at(arena, current, idx)
            // Skip "." after index
            if pos < path.len && (path.get(pos..pos + 1) else "") == "." {
                pos = pos + 1
            }
            continue
        }
        // Find next "." or "[", handling quoted keys
        var next = pos
        if (path.get(pos..pos + 1) else "") == "\"" {
            // Quoted key: find the closing quote
            next = pos + 1
            while next < path.len {
                let ch = path.get(next..next + 1) else ""
                if ch == "\"" {
                    break
                }
                next = next + 1
            }
            next = next + 1 // skip closing quote
        } else {
            while next < path.len {
                let ch = path.get(next..next + 1) else ""
                if ch == "." || ch == "[" {
                    break
                }
                next = next + 1
            }
        }
        var key = path.get(pos..next) else ""
        // Strip quotes from the key
        if key.starts_with("\"") && key.ends_with("\"") {
            key = key.get(1..key.len - 1) else key
        }
        pos = next
        // Skip "."
        if pos < path.len && (path.get(pos..pos + 1) else "") == "." {
            pos = pos + 1
        }
        // Find key in current node
        if node_kind(arena, current) != 0 {
            return -1
        }
        let nkeys = node_key_len(arena, current)
        var found = false
        var i = 0
        while i < nkeys {
            if node_key_at(arena, current, i) == key {
                current = node_kid_at(arena, current, i)
                found = true
                break
            }
            i = i + 1
        }
        if !found {
            return -1
        }
    }
    current
}

/// Print the keys of a table node.
fn print_keys(arena: List[Node], i: int) {
    if node_kind(arena, i) != 0 {
        print("not a table")
        return
    }
    let nkeys = node_key_len(arena, i)
    var j = 0
    while j < nkeys {
        print(node_key_at(arena, i, j))
        j = j + 1
    }
}

/// Print the length of a table or array node.
fn print_len(arena: List[Node], i: int) {
    let kind = node_kind(arena, i)
    if kind == 0 || kind == 1 {
        let nkids = node_kid_len(arena, i)
        print("{nkids}")
    } else {
        print("not a container")
    }
}

/// Print the raw value of a node.
fn print_raw_value(arena: List[Node], i: int) {
    let kind = node_kind(arena, i)
    if kind == 2 {
        print(node_str(arena, i))
    } else if kind == 3 {
        print("{node_int(arena, i)}")
    } else if kind == 4 {
        print("{node_float(arena, i)}")
    } else if kind == 5 {
        if node_bool(arena, i) {
            print("true")
        } else {
            print("false")
        }
    } else if kind >= 6 && kind <= 9 {
        print(node_str(arena, i))
    } else {
        print("not a scalar")
    }
}

/// Parse a file and navigate to a path, then perform an action.
fn query_file(path: str, file: str, action: str) -> !int {
    let text = read_input(file) else |ReadError(msg)| {
        eprint("tomlq: {file}: {msg}\n")
        return 2
    }
    var p = parser_init(text)
    let root = parse_document(mut p) else |e| match e {
        ParseError(l, c, m) => {
            eprint("tomlq: {file}:{l}:{c}: {m}\n")
            return 2
        },
    }
    let node = navigate_path(p.arena, root, path)
    if node < 0 {
        return 1
    }
    if action == "keys" {
        print_keys(p.arena, node)
    } else if action == "len" {
        print_len(p.arena, node)
    } else if action == "raw" {
        print_raw_value(p.arena, node)
    } else {
        // Default: print raw value for scalars, JSON for containers
        let kind = node_kind(p.arena, node)
        if kind >= 2 && kind <= 9 {
            // Scalar: print raw value
            print_raw_value(p.arena, node)
        } else {
            // Container: print JSON
            let j = emit_json(p.arena, node) else |e| match e {
                ParseError(l, c, m) => {
                    eprint("tomlq: {file}:{l}:{c}: {m}\n")
                    return 2
                },
            }
            print(j)
        }
    }
    0
}

/// Collect all .toml files in a directory recursively.
fn collect_toml_files(dir: str, mut result: List[str]) {
    let entries = fs.read_dir(dir) else |err| {
        eprint("tomlq: {dir}: {err}\n")
        return
    }
    var e = 0
    while e < entries.len {
        let name = entries[e]
        e = e + 1
        let path = dir + "/" + name
        if name.ends_with(".toml") {
            (mut result).push(path)
        } else {
            // Check if it's a directory
            let sub_entries = fs.read_dir(path) else |err2| {
                // Not a directory, skip
                continue
            }
            collect_toml_files(path, mut result)
        }
    }
}

/// Read the 1.0 file list from DIR/files-toml-1.0.0. Returns a list of relative paths.
fn read_1_0_list(dir: str) -> List[str] {
    var result = List[str]()
    let list_path = dir + "/files-toml-1.0.0"
    let text = fs.read_text(list_path) else |err| {
        eprint("tomlq: {list_path}: {err}\n")
        return result
    }
    var pos = 0
    while pos < text.len {
        // Find next newline
        var end = pos
        while end < text.len {
            let ch = text.get(end..end + 1) else ""
            if ch == "\n" {
                break
            }
            end = end + 1
        }
        let line = text.get(pos..end) else ""
        pos = end + 1
        if line.len > 0 {
            (mut result).push(line)
        }
    }
    result
}

/// Run spec tests in DIR. Handles both valid/ (compare) and invalid/ (reject).
fn spec_run(dir: str, verbose: bool, only: str) -> !int {
    // Read the 1.0 file list
    let file_list = read_1_0_list(dir)
    var valid_passed = 0
    var valid_total = 0
    var invalid_passed = 0
    var invalid_total = 0
    var e = 0
    while e < file_list.len {
        let rel = file_list[e]
        e = e + 1
        if only.len > 0 && !rel.starts_with(only) {
            continue
        }
        // Skip .json files (they are twins, not tests)
        if rel.ends_with(".json") {
            continue
        }
        let toml_path = dir + "/" + rel
        // Determine if this is a valid or invalid test
        let is_invalid = rel.starts_with("invalid/")
        // Read the TOML file
        let text = fs.read_text(toml_path) else |err| {
            if is_invalid {
                // Rejection at read level counts as a pass for invalid tests
                invalid_passed = invalid_passed + 1
                invalid_total = invalid_total + 1
                if verbose {
                    print("PASS {rel} (rejected: {err})")
                }
            } else {
                print("FAIL {rel}: {err}")
                valid_total = valid_total + 1
            }
            continue
        }
        // Parse the TOML
        var p = parser_init(text)
        let root = parse_document(mut p) else |e| match e {
            ParseError(l, c, m) => {
                // Parse failed
                if is_invalid {
                    // Expected rejection
                    invalid_passed = invalid_passed + 1
                    invalid_total = invalid_total + 1
                    if verbose {
                        print("PASS {rel} (rejected: {m})")
                    }
                } else {
                    // Unexpected rejection
                    valid_total = valid_total + 1
                    if verbose {
                        print("FAIL {rel}:{l}:{c}: {m}")
                    }
                }
                continue
            },
        }
        // Parse succeeded
        if is_invalid {
            // Should have been rejected
            invalid_total = invalid_total + 1
            if verbose {
                print("FAIL {rel} (accepted, should reject)")
            }
        } else {
            // Valid test: compare against .json twin
            valid_total = valid_total + 1
            let base = rel.get(0..rel.len - 5) else ""
            let json_name2 = base + ".json"
            let expected_path = dir + "/" + json_name2
            let expected = fs.read_text(expected_path) else |err| {
                if verbose {
                    print("SKIP {rel}: {err}")
                }
                continue
            }
            let actual = emit_tagged(p.arena, root) else |e| match e {
                ParseError(l, c, m) => {
                    if verbose {
                        print("FAIL {rel}:{l}:{c}: {m}")
                    }
                    continue
                },
            }
            // Read both sides as tagged JSON into arenas
            var arena_a = List[Node]()
            let root_a = read_tagged(mut arena_a, actual) else |e| {
                if verbose {
                    print("FAIL {rel}: cannot read own output: {e}")
                }
                continue
            }
            var arena_b = List[Node]()
            let root_b = read_tagged(mut arena_b, expected) else |e| {
                if verbose {
                    print("FAIL {rel}: cannot read twin: {e}")
                }
                continue
            }
            let diff = tree_diff(arena_a, root_a, arena_b, root_b, "")
            if diff == "" {
                valid_passed = valid_passed + 1
                if verbose {
                    print("PASS {rel}")
                }
            } else if verbose {
                print("FAIL {rel}: {diff}")
            }
        }
    }
    print("valid: {valid_passed}/{valid_total} passed")
    print("invalid: {invalid_passed}/{invalid_total} passed")
    if valid_passed < valid_total || invalid_passed < invalid_total {
        return 1
    }
    0
}

fn main() -> !int {
    let args = env_args()
    if args.len == 0 {
        return usage_err()
    }
    if args[0] == "--version" {
        print("tomlq 0.1.0 (built with wolf 0.2.34)")
        return 0
    }
    if args[0] == "--help" {
        return usage()
    }
    if args[0] == "--test-lexer" {
        return lexer_main()
    }
    if args[0] == "--tokens" {
        if args.len < 2 {
            eprint("tomlq: missing file argument\n")
            return 2
        }
        return tokens_file(args[1])
    }
    if args[0] == "--json" {
        if args.len < 2 {
            eprint("tomlq: missing file argument\n")
            return 2
        }
        return json_file(args[1])
    }
    if args[0] == "--tagged" {
        if args.len < 2 {
            eprint("tomlq: missing file argument\n")
            return 2
        }
        return tagged_file(args[1])
    }
    if args[0] == "--keys" {
        if args.len < 3 {
            eprint("tomlq: usage: tomlq --keys PATH FILE\n")
            return 2
        }
        return query_file(args[1], args[2], "keys")
    }
    if args[0] == "--len" {
        if args.len < 3 {
            eprint("tomlq: usage: tomlq --len PATH FILE\n")
            return 2
        }
        return query_file(args[1], args[2], "len")
    }
    if args[0] == "--raw" {
        if args.len < 3 {
            eprint("tomlq: usage: tomlq --raw PATH FILE\n")
            return 2
        }
        return query_file(args[1], args[2], "raw")
    }
    if args[0] == "--spec" {
        if args.len < 2 {
            eprint("tomlq: missing directory argument\n")
            return 2
        }
        let dir = args[1]
        var verbose = false
        var only = ""
        var i = 2
        while i < args.len {
            if args[i] == "--spec-verbose" {
                verbose = true
            } else if args[i] == "--only" {
                i = i + 1
                if i < args.len {
                    only = args[i]
                }
            }
            i = i + 1
        }
        return spec_run(dir, verbose, only)
    }
    // Check for PATH FILE form (no flag)
    if args.len >= 2 && !args[0].starts_with("-") {
        return query_file(args[0], args[1], "json")
    }
    // Unknown option
    if args[0].starts_with("-") {
        eprint("tomlq: unknown option: {args[0]}\n")
        return usage_err()
    }
    return not_implemented()
}
