//! check: run(exit=0)

use std.bytes

/// A cursor into a byte string, tracking line and column.
struct Cursor {
    s: str,
    pos: int,
    line: int,
    col: int,
}

/// Create a cursor at the start of a string.
fn cursor_init(s: str) -> Cursor {
    Cursor { s: s, pos: 0, line: 1, col: 1 }
}

/// The whole UTF-8 character starting at byte `pos` of `s`, or "" at the end.
/// A slice that splits a character is refused, so try one to four bytes.
fn char_at(s: str, pos: int) -> str {
    var n = 1
    while n <= 4 && pos + n <= s.len {
        let ch = s.get(pos..pos + n) else ""
        if ch != "" {
            return ch
        }
        n = n + 1
    }
    ""
}

/// Advance the cursor by one byte, updating line/col for newlines.
fn cursor_advance(mut c: Cursor) {
    if c.pos >= c.s.len {
        return
    }
    // Check if the byte we're about to pass is a newline
    let ch = char_at(c.s, c.pos)
    c.pos = c.pos + (if ch.len > 0 then ch.len else 1)
    if ch == "\n" {
        c.line = c.line + 1
        c.col = 1
    } else {
        c.col = c.col + 1
    }
}

/// Peek at the byte at the current position, or "" if at end.
fn cursor_peek(c: Cursor) -> str {
    if c.pos >= c.s.len {
        return ""
    }
    char_at(c.s, c.pos)
}

/// Check if the cursor is at end of input.
fn cursor_at_end(c: Cursor) -> bool {
    c.pos >= c.s.len
}

/// Skip whitespace only (not comments). Returns true if something was skipped.
fn cursor_skip_ws(mut c: Cursor) -> bool {
    var changed = false
    while !cursor_at_end(c) {
        let ch = cursor_peek(c)
        if ch == " " || ch == "\t" || ch == "\n" || ch == "\r" {
            cursor_advance(mut c)
            changed = true
        } else {
            break
        }
    }
    changed
}

/// Skip only spaces and tabs (not newlines or comments).
fn cursor_skip_spaces(mut c: Cursor) {
    while !cursor_at_end(c) {
        let ch = cursor_peek(c)
        if ch == " " || ch == "\t" {
            cursor_advance(mut c)
        } else {
            break
        }
    }
}

/// Skip whitespace and comments. Returns true if something was skipped.
fn cursor_skip_ws_comment(mut c: Cursor) -> bool ! {ParseError(int, int, str)} {
    var changed = false
    while !cursor_at_end(c) {
        let ch = cursor_peek(c)
        if ch == " " || ch == "\t" || ch == "\n" {
            cursor_advance(mut c)
            changed = true
        } else if ch == "\r" {
            // CR must be followed by LF
            cursor_advance(mut c)
            let next = cursor_peek(c)
            if next != "\n" {
                return ParseError(c.line, c.col, "bare CR in whitespace")
            }
            cursor_advance(mut c)
            changed = true
        } else if ch == "#" {
            // Skip to end of line, checking for control characters
            while !cursor_at_end(c) {
                let ch2 = cursor_peek(c)
                if ch2 == "\n" {
                    break
                }
                if ch2 == "\r" {
                    // CR must be followed by LF
                    cursor_advance(mut c)
                    let next = cursor_peek(c)
                    if next != "\n" {
                        return ParseError(c.line, c.col, "bare CR in comment")
                    }
                    cursor_advance(mut c)
                    break
                }
                if is_control(ch2) {
                    return ParseError(c.line, c.col, "control character in comment")
                }
                cursor_advance(mut c)
            }
            changed = true
        } else {
            break
        }
    }
    changed
}

/// Skip spaces, tabs, and comments, but NOT newlines. Returns true if anything was skipped.
fn cursor_skip_spaces_comment(mut c: Cursor) -> bool ! {ParseError(int, int, str)} {
    var changed = false
    while !cursor_at_end(c) {
        let ch = cursor_peek(c)
        if ch == " " || ch == "\t" {
            cursor_advance(mut c)
            changed = true
        } else if ch == "#" {
            // Skip to end of line, checking for control characters
            while !cursor_at_end(c) {
                let ch2 = cursor_peek(c)
                if ch2 == "\n" {
                    break
                }
                if ch2 == "\r" {
                    // CR must be followed by LF
                    cursor_advance(mut c)
                    let next = cursor_peek(c)
                    if next != "\n" {
                        return ParseError(c.line, c.col, "bare CR in comment")
                    }
                    cursor_advance(mut c)
                    break
                }
                if is_control(ch2) {
                    return ParseError(c.line, c.col, "control character in comment")
                }
                cursor_advance(mut c)
            }
            changed = true
        } else {
            break
        }
    }
    changed
}

/// Parse a hex digit. Returns the value or -1 if not a hex digit.
fn parse_hex_digit(ch: str) -> int {
    if ch == "0" { return 0 }
    if ch == "1" { return 1 }
    if ch == "2" { return 2 }
    if ch == "3" { return 3 }
    if ch == "4" { return 4 }
    if ch == "5" { return 5 }
    if ch == "6" { return 6 }
    if ch == "7" { return 7 }
    if ch == "8" { return 8 }
    if ch == "9" { return 9 }
    if ch == "a" || ch == "A" { return 10 }
    if ch == "b" || ch == "B" { return 11 }
    if ch == "c" || ch == "C" { return 12 }
    if ch == "d" || ch == "D" { return 13 }
    if ch == "e" || ch == "E" { return 14 }
    if ch == "f" || ch == "F" { return 15 }
    -1
}

/// Parse N hex digits from the cursor. Returns the value or -1 if not enough digits.
fn parse_hex_n(mut c: Cursor, n: int) -> int {
    var val = 0
    var i = 0
    while i < n {
        let ch = cursor_peek(c)
        let d = parse_hex_digit(ch)
        if d < 0 {
            return -1
        }
        val = val * 16 + d
        cursor_advance(mut c)
        i = i + 1
    }
    val
}

/// Check if a single-character string is a control character (0x00..0x1F except tab).
fn is_control(ch: str) -> bool {
    if ch == "\t" {
        return false
    }
    if ch == "\n" {
        return true
    }
    if ch == "\r" {
        return true
    }
    if ch == "\x08" {
        return true
    }
    if ch == "\x0C" {
        return true
    }
    // Check for other control characters by comparing with known ranges
    if ch.len == 1 {
        // For single-byte characters, we can check if they're in the control range
        // by comparing with known boundary characters
        if ch < " " {
            return true
        }
        // U+007F (DEL) is also a control character
        if ch == "\x7F" {
            return true
        }
    }
    false
}

/// Decode a Unicode code point to a UTF-8 string.
/// Encode a Unicode code point as UTF-8 (1 to 4 bytes).
fn code_point_to_str(cp: int) -> str {
    var out = List[byte]()
    if cp < 0x80 {
        (mut out).push(cp as byte)
    } else if cp < 0x800 {
        (mut out).push((0xC0 + cp / 64) as byte)
        (mut out).push((0x80 + cp % 64) as byte)
    } else if cp < 0x10000 {
        (mut out).push((0xE0 + cp / 4096) as byte)
        (mut out).push((0x80 + cp / 64 % 64) as byte)
        (mut out).push((0x80 + cp % 64) as byte)
    } else {
        (mut out).push((0xF0 + cp / 262144) as byte)
        (mut out).push((0x80 + cp / 4096 % 64) as byte)
        (mut out).push((0x80 + cp / 64 % 64) as byte)
        (mut out).push((0x80 + cp % 64) as byte)
    }
    bytes.to_str(out) else ""
}

/// Parse a basic string (double-quoted). Returns the decoded string or raises an error.
fn parse_basic_string(mut c: Cursor) -> str ! {ParseError(int, int, str)} {
    // Opening quote already consumed
    var result = ""
    while !cursor_at_end(c) {
        let ch = cursor_peek(c)
        if ch == "\"" {
            cursor_advance(mut c)
            return result
        }
        if ch == "\\" {
            cursor_advance(mut c)
            let esc = cursor_peek(c)
            if esc == "" {
                return ParseError(c.line, c.col, "unexpected end of string after \\")
            }
            cursor_advance(mut c)
            if esc == "b" {
                result = result + "\x08"
            } else if esc == "t" {
                result = result + "\t"
            } else if esc == "n" {
                result = result + "\n"
            } else if esc == "f" {
                result = result + "\x0C"
            } else if esc == "r" {
                result = result + "\r"
            } else if esc == "\"" {
                result = result + "\""
            } else if esc == "\\" {
                result = result + "\\"
            } else if esc == "e" {
                result = result + "\x1B"
            } else if esc == "u" {
                let val = parse_hex_n(mut c, 4)
                if val < 0 {
                    return ParseError(c.line, c.col, "invalid \\u escape")
                }
                // Check for surrogate code points (U+D800..U+DFFF)
                if val >= 0xD800 && val <= 0xDFFF {
                    return ParseError(c.line, c.col, "surrogate code point in \\u escape")
                }
                if val > 0x10FFFF {
                    return ParseError(c.line, c.col, "unicode code point out of range")
                }
                result = result + code_point_to_str(val)
            } else if esc == "U" {
                let val = parse_hex_n(mut c, 8)
                if val < 0 {
                    return ParseError(c.line, c.col, "invalid \\U escape")
                }
                // Check for surrogate code points
                if val >= 0xD800 && val <= 0xDFFF {
                    return ParseError(c.line, c.col, "surrogate code point in \\U escape")
                }
                if val > 0x10FFFF {
                    return ParseError(c.line, c.col, "unicode code point out of range")
                }
                result = result + code_point_to_str(val)
            } else {
                return ParseError(c.line, c.col, "invalid escape \\{esc}")
            }
        } else {
            // Check for control characters (0x00..0x1F except tab)
            if is_control(ch) {
                return ParseError(c.line, c.col, "control character in string")
            }
            result = result + ch
            cursor_advance(mut c)
        }
    }
    return ParseError(c.line, c.col, "unexpected end of input in string")
}

/// Parse a literal string (single-quoted). Returns the decoded string or raises an error.
fn parse_literal_string(mut c: Cursor) -> str ! {ParseError(int, int, str)} {
    // Opening quote already consumed
    var result = ""
    while !cursor_at_end(c) {
        let ch = cursor_peek(c)
        if ch == "'" {
            cursor_advance(mut c)
            return result
        }
        if ch == "\\" || ch == "\"" {
            // These are just literal characters in a literal string
            result = result + ch
            cursor_advance(mut c)
        } else {
            // Check for control characters and newlines
            if is_control(ch) || ch == "\n" {
                return ParseError(c.line, c.col, "control character in literal string")
            }
            result = result + ch
            cursor_advance(mut c)
        }
    }
    return ParseError(c.line, c.col, "unexpected end of input in literal string")
}

/// Count consecutive quote characters at the current position.
fn count_quotes(mut c: Cursor, q: str) -> int {
    var n = 0
    while !cursor_at_end(c) {
        let ch = cursor_peek(c)
        if ch == q {
            cursor_advance(mut c)
            n = n + 1
        } else {
            break
        }
    }
    n
}

/// Parse a multi-line basic string ("""). Returns the decoded string or raises an error.
fn parse_multiline_basic_string(mut c: Cursor) -> str ! {ParseError(int, int, str)} {
    // Opening """ already consumed
    var result = ""
    var after_open = true
    while !cursor_at_end(c) {
        // Check for closing """
        let rest = c.s.get(c.pos..) else ""
        if rest.starts_with("\"\"\"") {
            // Count the whole run of quotes
            var temp = copy c
            let n = count_quotes(mut temp, "\"")
            if n == 3 {
                // Exactly 3 quotes: close the string
                cursor_advance(mut c)
                cursor_advance(mut c)
                cursor_advance(mut c)
                return result
            } else if n == 4 || n == 5 {
                // 4 or 5 quotes: first n-3 are content, last 3 close
                var i = 0
                while i < n - 3 {
                    result = result + "\""
                    cursor_advance(mut c)
                    i = i + 1
                }
                cursor_advance(mut c)
                cursor_advance(mut c)
                cursor_advance(mut c)
                return result
            } else {
                // More than 5 quotes: invalid
                return ParseError(c.line, c.col, "too many closing quotes in multi-line string")
            }
        }
        let ch = cursor_peek(c)
        if ch == "\\" {
            after_open = false
            cursor_advance(mut c)
            let esc = cursor_peek(c)
            if esc == "" {
                return ParseError(c.line, c.col, "unexpected end of string after \\")
            }
            cursor_advance(mut c)
            if esc == "b" {
                result = result + "\x08"
            } else if esc == "t" {
                result = result + "\t"
            } else if esc == "n" {
                result = result + "\n"
            } else if esc == "f" {
                result = result + "\x0C"
            } else if esc == "r" {
                result = result + "\r"
            } else if esc == "\"" {
                result = result + "\""
            } else if esc == "\\" {
                result = result + "\\"
            } else if esc == "e" {
                result = result + "\x1B"
            } else if esc == "u" {
                let val = parse_hex_n(mut c, 4)
                if val < 0 {
                    return ParseError(c.line, c.col, "invalid \\u escape")
                }
                if val >= 0xD800 && val <= 0xDFFF {
                    return ParseError(c.line, c.col, "surrogate code point in \\u escape")
                }
                if val > 0x10FFFF {
                    return ParseError(c.line, c.col, "unicode code point out of range")
                }
                result = result + code_point_to_str(val)
            } else if esc == "U" {
                let val = parse_hex_n(mut c, 8)
                if val < 0 {
                    return ParseError(c.line, c.col, "invalid \\U escape")
                }
                if val >= 0xD800 && val <= 0xDFFF {
                    return ParseError(c.line, c.col, "surrogate code point in \\U escape")
                }
                if val > 0x10FFFF {
                    return ParseError(c.line, c.col, "unicode code point out of range")
                }
                result = result + code_point_to_str(val)
            } else if esc == "\n" || esc == "\r" || esc == " " || esc == "\t" {
                // A line-ending backslash: only spaces and tabs may follow it on
                // its line, and it trims that newline and every space, tab and
                // newline after it, up to the next other character.
                var newline = esc == "\n" || esc == "\r"
                while !cursor_at_end(c) {
                    let ws = cursor_peek(c)
                    if ws == "\n" || ws == "\r" {
                        newline = true
                        cursor_advance(mut c)
                    } else if ws == " " || ws == "\t" {
                        cursor_advance(mut c)
                    } else {
                        break
                    }
                }
                if !newline {
                    return ParseError(c.line, c.col, "invalid escape \\{esc}")
                }
            } else {
                return ParseError(c.line, c.col, "invalid escape \\{esc}")
            }
        } else if ch == "\"" {
            after_open = false
            // A lone " or "" inside """ is just content
            result = result + ch
            cursor_advance(mut c)
        } else {
            // Check for control characters (0x00..0x1F except tab and newline)
            if is_control(ch) && ch != "\n" && ch != "\r" {
                return ParseError(c.line, c.col, "control character in string")
            }
            // Check for bare CR (CR not followed by LF)
            if ch == "\r" {
                let next = c.s.get(c.pos + 1..c.pos + 2) else ""
                if next != "\n" {
                    return ParseError(c.line, c.col, "bare CR in string")
                }
            }
            // Handle the newline immediately after opening """
            if after_open {
                if ch == "\n" {
                    cursor_advance(mut c)
                    after_open = false
                    continue
                } else if ch == "\r" {
                    cursor_advance(mut c)
                    let next = cursor_peek(c)
                    if next == "\n" {
                        cursor_advance(mut c)
                    }
                    after_open = false
                    continue
                }
                after_open = false
            }
            result = result + ch
            cursor_advance(mut c)
        }
    }
    return ParseError(c.line, c.col, "unexpected end of input in multi-line string")
}

/// Parse a multi-line literal string ('''). Returns the decoded string or raises an error.
fn parse_multiline_literal_string(mut c: Cursor) -> str ! {ParseError(int, int, str)} {
    // Opening ''' already consumed
    var result = ""
    var after_open = true
    while !cursor_at_end(c) {
        // Check for closing '''
        let rest = c.s.get(c.pos..) else ""
        if rest.starts_with("'''") {
            // Count the whole run of quotes
            var temp = copy c
            let n = count_quotes(mut temp, "'")
            if n == 3 {
                // Exactly 3 quotes: close the string
                cursor_advance(mut c)
                cursor_advance(mut c)
                cursor_advance(mut c)
                return result
            } else if n == 4 || n == 5 {
                // 4 or 5 quotes: first n-3 are content, last 3 close
                var i = 0
                while i < n - 3 {
                    result = result + "'"
                    cursor_advance(mut c)
                    i = i + 1
                }
                cursor_advance(mut c)
                cursor_advance(mut c)
                cursor_advance(mut c)
                return result
            } else {
                // More than 5 quotes: invalid
                return ParseError(c.line, c.col, "too many closing quotes in multi-line string")
            }
        }
        let ch = cursor_peek(c)
        if ch == "'" {
            // A lone ' or '' inside ''' is just content
            result = result + ch
            cursor_advance(mut c)
        } else {
            // Check for control characters (0x00..0x1F except tab and newline)
            if is_control(ch) && ch != "\n" && ch != "\r" {
                return ParseError(c.line, c.col, "control character in literal string")
            }
            // Check for bare CR (CR not followed by LF)
            if ch == "\r" {
                let next = c.s.get(c.pos + 1..c.pos + 2) else ""
                if next != "\n" {
                    return ParseError(c.line, c.col, "bare CR in literal string")
                }
            }
            // Handle the newline immediately after opening '''
            if after_open {
                if ch == "\n" {
                    cursor_advance(mut c)
                    after_open = false
                    continue
                } else if ch == "\r" {
                    cursor_advance(mut c)
                    let next = cursor_peek(c)
                    if next == "\n" {
                        cursor_advance(mut c)
                    }
                    after_open = false
                    continue
                }
                after_open = false
            }
            result = result + ch
            cursor_advance(mut c)
        }
    }
    return ParseError(c.line, c.col, "unexpected end of input in multi-line literal string")
}

/// Parse a key string (basic or literal, not multiline).
/// The opening quote must be at the cursor.
fn parse_key_string(mut c: Cursor) -> str ! {ParseError(int, int, str)} {
    let rest = c.s.get(c.pos..) else ""
    if rest.starts_with("\"\"\"") || rest.starts_with("'''") {
        return ParseError(c.line, c.col, "multi-line string in key")
    }
    if rest.starts_with("\"") {
        cursor_advance(mut c)
        return parse_basic_string(mut c)
    }
    if rest.starts_with("'") {
        cursor_advance(mut c)
        return parse_literal_string(mut c)
    }
    return ParseError(c.line, c.col, "expected string in key")
}

/// Parse a string starting at the current cursor position.
/// The opening quote must be at the cursor.
fn parse_string(mut c: Cursor) -> str ! {ParseError(int, int, str)} {
    let rest = c.s.get(c.pos..) else ""
    if rest.starts_with("\"\"\"") {
        cursor_advance(mut c)
        cursor_advance(mut c)
        cursor_advance(mut c)
        return parse_multiline_basic_string(mut c)
    }
    if rest.starts_with("'''") {
        cursor_advance(mut c)
        cursor_advance(mut c)
        cursor_advance(mut c)
        return parse_multiline_literal_string(mut c)
    }
    if rest.starts_with("\"") {
        cursor_advance(mut c)
        return parse_basic_string(mut c)
    }
    if rest.starts_with("'") {
        cursor_advance(mut c)
        return parse_literal_string(mut c)
    }
    return ParseError(c.line, c.col, "expected string literal")
}

/// Tokenize a string value. Returns the decoded string.
fn tokenize_string(mut c: Cursor) -> str ! {ParseError(int, int, str)} {
    parse_string(mut c)
}

/// Parse an integer. Returns the raw text of the integer.
fn parse_integer(mut c: Cursor) -> i64 ! {ParseError(int, int, str)} {
    // Check for base prefix first (no sign allowed for non-decimal)
    let rest = c.s.get(c.pos..) else ""
    if rest.starts_with("0b") {
        // Binary — prefix must be lowercase
        cursor_advance(mut c)
        cursor_advance(mut c)
        let digits = parse_digit_run(mut c, 2)?
        let clean = digits.replace("_", "")
        let v = parse_int_base(clean, 2)?
        return v
    }
    if rest.starts_with("0B") {
        return ParseError(c.line, c.col, "uppercase prefix in integer")
    }
    if rest.starts_with("0o") {
        // Octal
        cursor_advance(mut c)
        cursor_advance(mut c)
        let digits = parse_digit_run(mut c, 8)?
        let clean = digits.replace("_", "")
        let v = parse_int_base(clean, 8)?
        return v
    }
    if rest.starts_with("0O") {
        return ParseError(c.line, c.col, "uppercase prefix in integer")
    }
    if rest.starts_with("0x") {
        // Hexadecimal
        cursor_advance(mut c)
        cursor_advance(mut c)
        let digits = parse_hex_run(mut c)?
        let clean = digits.replace("_", "")
        let v = parse_int_base(clean, 16)?
        return v
    }
    if rest.starts_with("0X") {
        return ParseError(c.line, c.col, "uppercase prefix in integer")
    }
    // Decimal: optional sign
    var sign: i64 = 1
    let first = cursor_peek(c)
    if first == "+" {
        cursor_advance(mut c)
    } else if first == "-" {
        sign = -1
        cursor_advance(mut c)
    }
    // Check for leading zero (invalid unless it's just "0")
    let ch = cursor_peek(c)
    if ch == "0" {
        let next = c.s.get(c.pos + 1..c.pos + 2) else ""
        if next.len > 0 {
            let nch = next[0..1]
            if nch >= "0" && nch <= "9" || nch == "_" {
                return ParseError(c.line, c.col, "leading zeros in integer")
            }
        }
    }
    // Parse digits
    let digits = parse_digit_run(mut c, 10)?
    let clean = digits.replace("_", "")
    if clean == "" {
        return ParseError(c.line, c.col, "empty integer")
    }
    // Check if it's the special case of -9223372036854775808
    if sign == -1 && clean == "9223372036854775808" {
        return -9223372036854775808
    }
    let v = parse_int_base(clean, 10)?
    if sign == 1 {
        return v
    }
    return sign * v
}

/// Parse a run of decimal digits (with underscores between digits).
fn parse_digit_run(mut c: Cursor, base: int) -> str ! {ParseError(int, int, str)} {
    var result = ""
    var last_was_digit = false
    while !cursor_at_end(c) {
        let ch = cursor_peek(c)
        if is_digit_for_base(ch, base) {
            result = result + ch
            cursor_advance(mut c)
            last_was_digit = true
        } else if ch == "_" && last_was_digit {
            cursor_advance(mut c)
            let next = cursor_peek(c)
            if is_digit_for_base(next, base) {
                result = result + "_"
                last_was_digit = false
            } else {
                return ParseError(c.line, c.col, "invalid character after underscore in integer")
            }
        } else {
            break
        }
    }
    if result == "" || result.ends_with("_") {
        return ParseError(c.line, c.col, "empty integer")
    }
    result
}

/// Parse a run of hex digits (with underscores between digits).
fn parse_hex_run(mut c: Cursor) -> str ! {ParseError(int, int, str)} {
    var result = ""
    var last_was_digit = false
    while !cursor_at_end(c) {
        let ch = cursor_peek(c)
        if is_hex_char(ch) {
            result = result + ch
            cursor_advance(mut c)
            last_was_digit = true
        } else if ch == "_" && last_was_digit {
            cursor_advance(mut c)
            let next = cursor_peek(c)
            if is_hex_char(next) {
                result = result + "_"
                last_was_digit = false
            } else {
                return ParseError(c.line, c.col, "invalid character after underscore in integer")
            }
        } else {
            break
        }
    }
    if result == "" || result.ends_with("_") {
        return ParseError(c.line, c.col, "empty integer")
    }
    result
}

/// Check if a character is a valid digit for the given base.
fn is_digit_for_base(ch: str, base: int) -> bool {
    if base == 2 {
        return ch == "0" || ch == "1"
    }
    if base == 8 {
        return ch >= "0" && ch <= "7"
    }
    return ch >= "0" && ch <= "9"
}

/// Parse a string as an integer in the given base. Returns error on overflow.
fn parse_int_base(s: str, base: int) -> i64 ! {ParseError(int, int, str)} {
    if base == 10 {
        let v = s.to_int() else return ParseError(0, 0, "integer overflow")
        return v as i64
    }
    var result: i64 = 0
    var i = 0
    while i < s.len {
        let ch = s.get(i..i + 1) else ""
        let digit = hex_value(ch)
        if digit < 0 || digit >= base {
            return ParseError(0, 0, "invalid digit for base {base}")
        }
        // Check for overflow: result * base + digit > max
        // Equivalent to: result > (max - digit) / base
        let max: i64 = 9223372036854775807
        if result > (max - digit as i64) / base as i64 {
            return ParseError(0, 0, "integer overflow")
        }
        result = result * base as i64 + digit as i64
        i = i + 1
    }
    result
}

/// Return the numeric value of a hex digit, or -1 if not a hex digit.
fn hex_value(ch: str) -> int {
    if ch >= "0" && ch <= "9" {
        return ch.to_int() else -1
    }
    if ch == "a" { return 10 }
    if ch == "b" { return 11 }
    if ch == "c" { return 12 }
    if ch == "d" { return 13 }
    if ch == "e" { return 14 }
    if ch == "f" { return 15 }
    if ch == "A" { return 10 }
    if ch == "B" { return 11 }
    if ch == "C" { return 12 }
    if ch == "D" { return 13 }
    if ch == "E" { return 14 }
    if ch == "F" { return 15 }
    -1
}

/// Check if a character is a hex digit.
fn is_hex_char(ch: str) -> bool {
    if ch >= "0" && ch <= "9" {
        return true
    }
    if ch >= "a" && ch <= "f" {
        return true
    }
    if ch >= "A" && ch <= "F" {
        return true
    }
    false
}

/// Parse a float. Returns the raw text of the float.
fn parse_float(mut c: Cursor) -> f64 ! {ParseError(int, int, str)} {
    // Optional sign
    var sign = 1.0
    let first = cursor_peek(c)
    if first == "+" {
        cursor_advance(mut c)
    } else if first == "-" {
        sign = -1.0
        cursor_advance(mut c)
    }
    // Check for inf/nan
    let rest = c.s.get(c.pos..) else ""
    if rest.starts_with("inf") {
        // Must be exactly "inf" (not followed by a letter, digit, or _)
        let after = c.s.get(c.pos + 3..c.pos + 4) else ""
        if after.len > 0 {
            let ch = after[0..1]
            if ch >= "a" && ch <= "z" ||
                ch >= "A" && ch <= "Z" ||
                ch >= "0" && ch <= "9" ||
                ch == "_" {
                return ParseError(c.line, c.col, "invalid float")
            }
        }
        cursor_advance(mut c)
        cursor_advance(mut c)
        cursor_advance(mut c)
        return sign * 1.0 / 0.0 // inf or -inf
    }
    if rest.starts_with("nan") {
        // Must be exactly "nan" (not followed by a letter, digit, or _)
        let after = c.s.get(c.pos + 3..c.pos + 4) else ""
        if after.len > 0 {
            let ch = after[0..1]
            if ch >= "a" && ch <= "z" ||
                ch >= "A" && ch <= "Z" ||
                ch >= "0" && ch <= "9" ||
                ch == "_" {
                return ParseError(c.line, c.col, "invalid float")
            }
        }
        cursor_advance(mut c)
        cursor_advance(mut c)
        cursor_advance(mut c)
        return 0.0 / 0.0 // nan
    }
    // Parse digits before decimal point — must have at least one
    let before = parse_float_digits(mut c)?
    if before == "" {
        return ParseError(c.line, c.col, "no digits before decimal point in float")
    }
    // Check for leading zero
    if before.starts_with("0") && before.len > 1 {
        let next = before.get(1..2) else ""
        if next.len > 0 && next[0..1] >= "0" && next[0..1] <= "9" {
            return ParseError(c.line, c.col, "leading zeros in float")
        }
    }
    // Check for decimal point
    var after_dot = ""
    let dot = cursor_peek(c)
    if dot == "." {
        cursor_advance(mut c)
        // Must have at least one digit after decimal point
        after_dot = parse_float_digits(mut c)?
        if after_dot == "" {
            return ParseError(c.line, c.col, "no digits after decimal point in float")
        }
    }
    // Check for exponent
    var exp_str = ""
    let exp = cursor_peek(c)
    if exp == "e" || exp == "E" {
        cursor_advance(mut c)
        // Optional sign
        let sign2 = cursor_peek(c)
        if sign2 == "+" || sign2 == "-" {
            exp_str = exp_str + sign2
            cursor_advance(mut c)
        }
        // Must have at least one digit
        let exp_digits = parse_float_digits(mut c)?
        if exp_digits == "" {
            return ParseError(c.line, c.col, "no digits in exponent of float")
        }
        exp_str = exp_str + exp_digits.replace("_", "")
    }
    // Build the clean string and parse
    var clean = before.replace("_", "")
    if after_dot != "" {
        clean = clean + "." + after_dot.replace("_", "")
    }
    if exp_str != "" {
        clean = clean + "e" + exp_str
    }
    // Parse the float
    let v = parse_float_str(clean) else 0.0
    return sign * v
}

/// 10^n as an int.
fn pow10(n: int) -> int {
    var result = 1
    var i = 0
    while i < n {
        result = result * 10
        i = i + 1
    }
    result
}

/// Parse a string as an f64. Returns 0.0 on error.
fn parse_float_str(s: str) -> f64 ! {ParseError(int, int, str)} {
    // Handle inf/nan
    if s == "inf" {
        return 1.0 / 0.0
    }
    if s == "-inf" {
        return -1.0 / 0.0
    }
    if s == "nan" {
        return 0.0 / 0.0
    }
    // Parse the integer part
    var dot_pos = s.find(".") else -1
    var exp_pos = s.find("e") else -1
    if exp_pos < 0 {
        exp_pos = s.find("E") else -1
    }
    var int_part = 0
    var frac_part = 0
    var frac_scale = 1
    var exp = 0
    if dot_pos >= 0 {
        let int_str = s.get(0..dot_pos) else ""
        int_part = int_str.to_int() else 0
        let frac_str = s.get(dot_pos + 1..) else ""
        if exp_pos >= 0 {
            let exp_in_frac = exp_pos - dot_pos - 1
            let frac_before_exp = frac_str.get(0..exp_in_frac) else ""
            frac_part = frac_before_exp.to_int() else 0
            frac_scale = pow10(frac_before_exp.len)
            let exp_str = frac_str.get(exp_in_frac + 1..) else ""
            exp = exp_str.to_int() else 0
        } else {
            frac_part = frac_str.to_int() else 0
            frac_scale = pow10(frac_str.len)
        }
    } else if exp_pos >= 0 {
        let int_str = s.get(0..exp_pos) else ""
        int_part = int_str.to_int() else 0
        let exp_str = s.get(exp_pos + 1..) else ""
        exp = exp_str.to_int() else 0
    } else {
        int_part = s.to_int() else 0
    }
    // Combine
    var result = int_part as f64 + frac_part as f64 / frac_scale as f64
    // Apply exponent (multiply by 10^exp)
    if exp > 0 {
        var i = 0
        while i < exp {
            result = result * 10.0
            i = i + 1
        }
    } else if exp < 0 {
        var i = 0
        while i < -exp {
            result = result / 10.0
            i = i + 1
        }
    }
    result
}

/// Parse a run of decimal digits (with underscores between digits) for floats.
fn parse_float_digits(mut c: Cursor) -> str ! {ParseError(int, int, str)} {
    var result = ""
    var last_was_digit = false
    while !cursor_at_end(c) {
        let ch = cursor_peek(c)
        if ch >= "0" && ch <= "9" {
            result = result + ch
            cursor_advance(mut c)
            last_was_digit = true
        } else if ch == "_" && last_was_digit {
            cursor_advance(mut c)
            let next = cursor_peek(c)
            if next >= "0" && next <= "9" {
                result = result + "_"
                last_was_digit = false
            } else {
                return ParseError(c.line, c.col, "invalid character after underscore in float")
            }
        } else {
            break
        }
    }
    if result.ends_with("_") {
        return ParseError(c.line, c.col, "trailing underscore in float")
    }
    result
}

/// Parse a boolean. Returns "true" or "false".
fn parse_boolean(mut c: Cursor) -> str ! {ParseError(int, int, str)} {
    let rest = c.s.get(c.pos..) else ""
    if rest.starts_with("true") {
        cursor_advance(mut c)
        cursor_advance(mut c)
        cursor_advance(mut c)
        cursor_advance(mut c)
        return "true"
    }
    if rest.starts_with("false") {
        cursor_advance(mut c)
        cursor_advance(mut c)
        cursor_advance(mut c)
        cursor_advance(mut c)
        cursor_advance(mut c)
        return "false"
    }
    return ParseError(c.line, c.col, "invalid boolean")
}

/// Parse a date-time value. Returns the normalized text.
fn parse_datetime(mut c: Cursor) -> str ! {ParseError(int, int, str)} {
    var result = ""
    // Parse year (4 digits, no leading zeros beyond 4)
    let year = parse_digits_n(mut c, 4)
    if year < 0 {
        return ParseError(c.line, c.col, "invalid year in date-time")
    }
    result = result + pad4(year)
    // Check for date-month separator
    let sep = cursor_peek(c)
    if sep != "-" {
        return ParseError(c.line, c.col, "missing - in date-time")
    }
    result = result + "-"
    cursor_advance(mut c)
    // Parse month (01-12)
    let month = parse_digits_n(mut c, 2)
    if month < 1 || month > 12 {
        return ParseError(c.line, c.col, "invalid month in date-time")
    }
    result = result + pad2(month)
    // Check for date-mday separator
    let sep2 = cursor_peek(c)
    if sep2 != "-" {
        return ParseError(c.line, c.col, "missing - in date-time")
    }
    result = result + "-"
    cursor_advance(mut c)
    // Parse day (01-31, validated later)
    let day = parse_digits_n(mut c, 2)
    if day < 1 || day > 31 {
        return ParseError(c.line, c.col, "invalid day in date-time")
    }
    result = result + pad2(day)
    // Check for time separator (T, t, or space)
    let time_sep = cursor_peek(c)
    if time_sep == "T" || time_sep == "t" {
        // Time component
        result = result + "T"
        cursor_advance(mut c)
        // Parse hour (00-23)
        let hour = parse_digits_n(mut c, 2)
        if hour < 0 || hour > 23 {
            return ParseError(c.line, c.col, "invalid hour in date-time")
        }
        result = result + pad2(hour)
        // Check for : separator
        let sep3 = cursor_peek(c)
        if sep3 != ":" {
            return ParseError(c.line, c.col, "missing : in date-time")
        }
        result = result + ":"
        cursor_advance(mut c)
        // Parse minute (00-59)
        let minute = parse_digits_n(mut c, 2)
        if minute < 0 || minute > 59 {
            return ParseError(c.line, c.col, "invalid minute in date-time")
        }
        result = result + pad2(minute)
        // Required seconds
        let sep4 = cursor_peek(c)
        if sep4 != ":" {
            return ParseError(c.line, c.col, "missing : in date-time")
        }
        result = result + ":"
        cursor_advance(mut c)
        // Parse second (00-60, leap second)
        let second = parse_digits_n(mut c, 2)
        if second < 0 || second > 60 {
            return ParseError(c.line, c.col, "invalid second in date-time")
        }
        result = result + pad2(second)
        // Optional fractional seconds
        let frac = cursor_peek(c)
        if frac == "." {
            result = result + "."
            cursor_advance(mut c)
            // Parse fractional digits (must have at least one)
            var has_frac_digit = false
            while !cursor_at_end(c) {
                let ch = cursor_peek(c)
                if ch >= "0" && ch <= "9" {
                    result = result + ch
                    cursor_advance(mut c)
                    has_frac_digit = true
                } else {
                    break
                }
            }
            if !has_frac_digit {
                return ParseError(c.line, c.col, "no digits after . in date-time")
            }
        }
        // Check for timezone
        let tz = cursor_peek(c)
        if tz == "Z" || tz == "z" {
            result = result + "Z"
            cursor_advance(mut c)
        } else if tz == "+" || tz == "-" {
            result = result + tz
            cursor_advance(mut c)
            // Parse offset hour (00-23)
            let off_hour = parse_digits_n(mut c, 2)
            if off_hour < 0 || off_hour > 23 {
                return ParseError(c.line, c.col, "invalid offset hour in date-time")
            }
            result = result + pad2(off_hour)
            // Check for : separator
            let sep5 = cursor_peek(c)
            if sep5 != ":" {
                return ParseError(c.line, c.col, "missing : in date-time offset")
            }
            result = result + ":"
            cursor_advance(mut c)
            // Parse offset minute (00-59)
            let off_minute = parse_digits_n(mut c, 2)
            if off_minute < 0 || off_minute > 59 {
                return ParseError(c.line, c.col, "invalid offset minute in date-time")
            }
            result = result + pad2(off_minute)
        }
    } else if time_sep == " " {
        // Space separator: check if followed by a digit (hour)
        cursor_advance(mut c)
        let next = cursor_peek(c)
        if next >= "0" && next <= "9" {
            // Time component
            result = result + "T"
            // Parse hour (00-23)
            let hour = parse_digits_n(mut c, 2)
            if hour < 0 || hour > 23 {
                return ParseError(c.line, c.col, "invalid hour in date-time")
            }
            result = result + pad2(hour)
            // Check for : separator
            let sep3 = cursor_peek(c)
            if sep3 != ":" {
                return ParseError(c.line, c.col, "missing : in date-time")
            }
            result = result + ":"
            cursor_advance(mut c)
            // Parse minute (00-59)
            let minute = parse_digits_n(mut c, 2)
            if minute < 0 || minute > 59 {
                return ParseError(c.line, c.col, "invalid minute in date-time")
            }
            result = result + pad2(minute)
            // Required seconds
            let sep4 = cursor_peek(c)
            if sep4 != ":" {
                return ParseError(c.line, c.col, "missing : in date-time")
            }
            result = result + ":"
            cursor_advance(mut c)
            // Parse second (00-60, leap second)
            let second = parse_digits_n(mut c, 2)
            if second < 0 || second > 60 {
                return ParseError(c.line, c.col, "invalid second in date-time")
            }
            result = result + pad2(second)
            // Optional fractional seconds
            let frac = cursor_peek(c)
            if frac == "." {
                result = result + "."
                cursor_advance(mut c)
                // Parse fractional digits (must have at least one)
                var has_frac_digit = false
                while !cursor_at_end(c) {
                    let ch = cursor_peek(c)
                    if ch >= "0" && ch <= "9" {
                        result = result + ch
                        cursor_advance(mut c)
                        has_frac_digit = true
                    } else {
                        break
                    }
                }
                if !has_frac_digit {
                    return ParseError(c.line, c.col, "no digits after . in date-time")
                }
            }
            // Check for timezone
            let tz = cursor_peek(c)
            if tz == "Z" || tz == "z" {
                result = result + "Z"
                cursor_advance(mut c)
            } else if tz == "+" || tz == "-" {
                result = result + tz
                cursor_advance(mut c)
                // Parse offset hour (00-23)
                let off_hour = parse_digits_n(mut c, 2)
                if off_hour < 0 || off_hour > 23 {
                    return ParseError(c.line, c.col, "invalid offset hour in date-time")
                }
                result = result + pad2(off_hour)
                // Check for : separator
                let sep5 = cursor_peek(c)
                if sep5 != ":" {
                    return ParseError(c.line, c.col, "missing : in date-time offset")
                }
                result = result + ":"
                cursor_advance(mut c)
                // Parse offset minute (00-59)
                let off_minute = parse_digits_n(mut c, 2)
                if off_minute < 0 || off_minute > 59 {
                    return ParseError(c.line, c.col, "invalid offset minute in date-time")
                }
                result = result + pad2(off_minute)
            }
        } else {
            // Not a time component, stop here
            return result
        }
    } else {
        // No time component, stop here
        return result
    }
    // Validate day for month
    let m = month
    let d = day
    let max_day = days_in_month(year, m)
    if d > max_day {
        return ParseError(c.line, c.col, "invalid day for month in date-time")
    }
    result
}

/// Parse exactly N digits and return the value, or -1 if not enough digits.
fn parse_digits_n(mut c: Cursor, n: int) -> int {
    var val = 0
    var i = 0
    while i < n {
        let ch = cursor_peek(c)
        if ch < "0" || ch > "9" {
            return -1
        }
        val = val * 10 + parse_hex_digit(ch)
        cursor_advance(mut c)
        i = i + 1
    }
    val
}

/// Pad a number to 2 digits.
fn pad2(n: int) -> str {
    if n < 10 {
        "0{n}"
    } else {
        "{n}"
    }
}

/// Pad to 4 digits.
fn pad4(n: int) -> str {
    if n < 10 {
        "000{n}"
    } else if n < 100 {
        "00{n}"
    } else if n < 1000 {
        "0{n}"
    } else {
        "{n}"
    }
}

/// Return the maximum day for a month (1-indexed), given the year.
fn days_in_month(year: int, month: int) -> int {
    if month == 2 {
        if is_leap_year(year) {
            return 29
        }
        return 28
    }
    if month == 4 || month == 6 || month == 9 || month == 11 {
        return 30
    }
    31
}

/// Check if a year is a leap year (Gregorian calendar).
fn is_leap_year(year: int) -> bool {
    if year % 400 == 0 {
        return true
    }
    if year % 100 == 0 {
        return false
    }
    if year % 4 == 0 {
        return true
    }
    false
}

/// Parse a local time. Returns the normalized text.
fn parse_local_time(mut c: Cursor) -> str ! {ParseError(int, int, str)} {
    var result = ""
    // Parse hour (00-23)
    let hour = parse_digits_n(mut c, 2)
    if hour < 0 || hour > 23 {
        return ParseError(c.line, c.col, "invalid hour in local time")
    }
    result = result + pad2(hour)
    // Check for : separator
    let sep = cursor_peek(c)
    if sep != ":" {
        return ParseError(c.line, c.col, "missing : in local time")
    }
    result = result + ":"
    cursor_advance(mut c)
    // Parse minute (00-59)
    let minute = parse_digits_n(mut c, 2)
    if minute < 0 || minute > 59 {
        return ParseError(c.line, c.col, "invalid minute in local time")
    }
    result = result + pad2(minute)
    // Required seconds
    let sep2 = cursor_peek(c)
    if sep2 != ":" {
        return ParseError(c.line, c.col, "missing : in local time")
    }
    result = result + ":"
    cursor_advance(mut c)
    // Parse second (00-60, leap second)
    let second = parse_digits_n(mut c, 2)
    if second < 0 || second > 60 {
        return ParseError(c.line, c.col, "invalid second in local time")
    }
    result = result + pad2(second)
    // Optional fractional seconds
    let frac = cursor_peek(c)
    if frac == "." {
        result = result + "."
        cursor_advance(mut c)
        // Parse fractional digits (must have at least one)
        var has_frac_digit = false
        while !cursor_at_end(c) {
            let ch = cursor_peek(c)
            if ch >= "0" && ch <= "9" {
                result = result + ch
                cursor_advance(mut c)
                has_frac_digit = true
            } else {
                break
            }
        }
        if !has_frac_digit {
            return ParseError(c.line, c.col, "no digits after . in local time")
        }
    }
    result
}

/// Parse a local date. Returns the normalized text.
fn parse_local_date(mut c: Cursor) -> str ! {ParseError(int, int, str)} {
    var result = ""
    // Parse year (4 digits)
    let year = parse_digits_n(mut c, 4)
    if year < 0 {
        return ParseError(c.line, c.col, "invalid year in local date")
    }
    result = result + pad4(year)
    // Check for - separator
    let sep = cursor_peek(c)
    if sep != "-" {
        return ParseError(c.line, c.col, "missing - in local date")
    }
    result = result + "-"
    cursor_advance(mut c)
    // Parse month (01-12)
    let month = parse_digits_n(mut c, 2)
    if month < 1 || month > 12 {
        return ParseError(c.line, c.col, "invalid month in local date")
    }
    result = result + pad2(month)
    // Check for - separator
    let sep2 = cursor_peek(c)
    if sep2 != "-" {
        return ParseError(c.line, c.col, "missing - in local date")
    }
    result = result + "-"
    cursor_advance(mut c)
    // Parse day (01-31)
    let day = parse_digits_n(mut c, 2)
    if day < 1 || day > 31 {
        return ParseError(c.line, c.col, "invalid day in local date")
    }
    result = result + pad2(day)
    // Validate day for month
    let max_day = days_in_month(year, month)
    if day > max_day {
        return ParseError(c.line, c.col, "invalid day for month in local date")
    }
    result
}

/// Check if the byte at position i in s is an ASCII digit.
fn is_digit(s: str, i: int) -> bool {
    if i >= s.len {
        return false
    }
    let b = s.get(i..i + 1) else ""
    b >= "0" && b <= "9"
}

/// Determine the kind of value at the current cursor position.
/// Returns: "string", "integer", "float", "bool", "datetime", "local-datetime", "local-date", "local-time", or ""
fn peek_value_kind(c: Cursor) -> str {
    let rest = c.s.get(c.pos..) else ""
    if rest.starts_with("\"") || rest.starts_with("'") {
        return "string"
    }
    if rest.starts_with("true") || rest.starts_with("false") {
        return "bool"
    }
    if rest.starts_with("inf") || rest.starts_with("nan") {
        return "float"
    }
    // Check for date-time: 4 digits followed by -
    if rest.len >= 5 {
        let d0 = is_digit(rest, 0)
        let d1 = is_digit(rest, 1)
        let d2 = is_digit(rest, 2)
        let d3 = is_digit(rest, 3)
        let dash = (rest.get(4..5) else "") == "-"
        if d0 && d1 && d2 && d3 && dash {
            // Could be a date or datetime
            // Check if there's a time component
            if rest.len >= 11 {
                let ch10 = rest.get(10..11) else ""
                if ch10 == "T" || ch10 == "t" {
                    return "datetime"
                }
                // Space is a time separator only if followed by a digit (the hour)
                if ch10 == " " && rest.len >= 12 {
                    let ch11 = rest.get(11..12) else ""
                    if ch11 >= "0" && ch11 <= "9" {
                        return "datetime"
                    }
                }
            }
            return "local-date"
        }
    }
    // Check for local time: 2 digits followed by :
    if rest.len >= 3 {
        let d0 = is_digit(rest, 0)
        let d1 = is_digit(rest, 1)
        let colon = (rest.get(2..3) else "") == ":"
        if d0 && d1 && colon {
            return "local-time"
        }
    }
    // Check for number: scan ahead to determine if it's a float or integer
    if rest.len >= 1 {
        let first = rest.get(0..1) else ""
        if first == "+" || first == "-" || first >= "0" && first <= "9" {
            // Skip sign if present
            var i = 0
            if first == "+" || first == "-" {
                i = 1
            }
            // Check for inf/nan after sign
            if i < rest.len {
                let after_sign = rest[i..]
                if after_sign.starts_with("inf") || after_sign.starts_with("nan") {
                    return "float"
                }
            }
            // Scan ahead to see if there's a . or e/E within the number
            while i < rest.len {
                let ch = rest.get(i..i + 1) else ""
                if ch >= "0" && ch <= "9" || ch == "_" {
                    i = i + 1
                } else if ch == "." {
                    return "float"
                } else if ch == "e" || ch == "E" {
                    return "float"
                } else {
                    break
                }
            }
            return "integer"
        }
    }
    ""
}

/// Tokenize a value. Returns the kind and the raw text.
fn tokenize_value(mut c: Cursor) -> str ! {ParseError(int, int, str)} {
    let kind = peek_value_kind(c)
    if kind == "string" {
        let v = parse_string(mut c)?
        return "STR {v}"
    }
    if kind == "integer" {
        let v = parse_integer(mut c)?
        return "INT {v}"
    }
    if kind == "float" {
        let v = parse_float(mut c)?
        return "FLT {v}"
    }
    if kind == "bool" {
        let v = parse_boolean(mut c)?
        return "BOOL {v}"
    }
    if kind == "datetime" {
        let v = parse_datetime(mut c)?
        return "DATETIME {v}"
    }
    if kind == "local-date" {
        let v = parse_local_date(mut c)?
        return "LOCAL-DATE {v}"
    }
    if kind == "local-time" {
        let v = parse_local_time(mut c)?
        return "LOCAL-TIME {v}"
    }
    return ParseError(c.line, c.col, "unknown value kind")
}

fn lexer_main() -> !int {
    // Test basic string parsing
    var c = cursor_init("\"hello world\"")
    let s = parse_string(mut c) else |err| {
        print("error: {err}")
        return 1
    }
    print("basic: {s}")

    // Test escape sequences
    var c2 = cursor_init("\"\\n\\t\\r\\b\\f\\\\\\\"\"")
    let s2 = parse_string(mut c2) else |err| {
        print("error: {err}")
        return 1
    }
    print("escapes: {s2}")

    // Test unicode escapes
    var c3 = cursor_init("\"\\u00E9\\U0001F600\"")
    let s3 = parse_string(mut c3) else |err| {
        print("error: {err}")
        return 1
    }
    print("unicode: {s3}")

    // Test literal string
    var c4 = cursor_init("'no escapes \\n here'")
    let s4 = parse_string(mut c4) else |err| {
        print("error: {err}")
        return 1
    }
    print("literal: {s4}")

    // Test multi-line basic string (newline after opening is trimmed)
    var c5 = cursor_init("\"\"\"\nline one\nline two\"\"\"")
    let s5 = parse_string(mut c5) else |err| {
        print("error: {err}")
        return 1
    }
    print("multiline: {s5}")

    // Test multi-line literal string (newline after opening is trimmed)
    var c6 = cursor_init("'''\nline one\nline two'''")
    let s6 = parse_string(mut c6) else |err| {
        print("error: {err}")
        return 1
    }
    print("mliteral: {s6}")

    // Test error: unterminated string
    var c7 = cursor_init("\"unterminated")
    let s7 = parse_string(mut c7) else |err| {
        print("error (expected): {err}")
        ""
    }

    // Test error: invalid escape
    var c8 = cursor_init("\"bad \\a escape\"")
    let s8 = parse_string(mut c8) else |err| {
        print("error (expected): {err}")
        ""
    }

    // Test error: surrogate code point
    var c9 = cursor_init("\"\\uD800\"")
    let s9 = parse_string(mut c9) else |err| {
        print("error (expected): {err}")
        ""
    }

    // Test error: out of range unicode
    var c10 = cursor_init("\"\\UFFFFFFFF\"")
    let s10 = parse_string(mut c10) else |err| {
        print("error (expected): {err}")
        ""
    }

    0
}
