//! check: run(exit=0)

/// A TOML document parser that builds an arena tree.
struct Parser {
    c: Cursor,
    arena: List[Node],
    current: int,
    tables: Map[str, int],
    arrays: Map[str, int],
    block: int,
}

/// Create a new parser.
/// Check if a datetime string has a timezone offset.
fn has_timezone(s: str) -> bool {
    if s.len == 0 {
        return false
    }
    let last = s.get(s.len - 1..) else ""
    if last == "Z" {
        return true
    }
    // Check for +HH:MM or -HH:MM at the end
    if s.len >= 6 {
        let tail = s.get(s.len - 6..) else ""
        if tail.len >= 6 {
            let sign = tail.get(0..1) else ""
            if sign == "+" || sign == "-" {
                return true
            }
        }
    }
    false
}

fn parser_init(text: str) -> Parser {
    let c = cursor_init(text)
    var arena = List[Node]()
    let root = table_node(mut arena, 0, 0)
    var tables = Map[str, int]()
    var arrays = Map[str, int]()
    Parser {
        c: c,
        arena: arena,
        current: root,
        tables: tables,
        arrays: arrays,
        block: 0,
    }
}

/// Parse a TOML document. Returns the root node index.
fn parse_document(mut p: Parser) -> int ! {ParseError(int, int, str)} {
    while !cursor_at_end(p.c) {
        cursor_skip_ws_comment(mut p.c)?
        if cursor_at_end(p.c) {
            break
        }
        let ch = cursor_peek(p.c)
        if ch == "[" {
            p.block = p.block + 1
            let header = parse_header(mut p)?
            if header.kind == 1 {
                p.current = header.node
            } else if header.kind == 2 {
                p.current = header.node
            }
        } else {
            let _ = parse_key_value(mut p)?
        }
    }
    0
}

/// Parse a table or array of tables header.
struct Header {
    kind: int,
    node: int,
}

fn parse_header(mut p: Parser) -> Header ! {ParseError(int, int, str)} {
    let ch = cursor_peek(p.c)
    if ch != "[" {
        return ParseError(p.c.line, p.c.col, "expected [")
    }
    cursor_advance(mut p.c)
    let ch2 = cursor_peek(p.c)
    // Check for newline after [ (unterminated table header)
    if ch2 == "\n" || ch2 == "\r" {
        return ParseError(p.c.line, p.c.col, "unterminated table header")
    }
    if ch2 == "[" {
        cursor_advance(mut p.c)
        // Check for newline after [[
        let ch3 = cursor_peek(p.c)
        if ch3 == "\n" || ch3 == "\r" {
            return ParseError(p.c.line, p.c.col, "unterminated table header")
        }
        let segments = parse_key(mut p)?
        cursor_skip_spaces_comment(mut p.c)?
        let ch3 = cursor_peek(p.c)
        if ch3 != "]" {
            return ParseError(p.c.line, p.c.col, "expected ]")
        }
        cursor_advance(mut p.c)
        let ch4 = cursor_peek(p.c)
        if ch4 != "]" {
            return ParseError(p.c.line, p.c.col, "expected ]")
        }
        cursor_advance(mut p.c)
        // Table header must be followed by newline or EOF
        require_newline_or_eof(mut p)?
        // Resolve the path: intermediate segments find or create tables,
        // and where a segment names an array of tables, continue into its last element.
        // The last segment names an array of tables; append a new table to it.
        let arr_node = or_resolve_array_for_path(mut p, segments)?
        let new_table = table_node(mut p.arena, 4, p.block)
        add_child(mut p.arena, arr_node, new_table)
        return Header { kind: 2, node: new_table }
    } else {
        // Check for newline after [
        let ch3 = cursor_peek(p.c)
        if ch3 == "\n" || ch3 == "\r" {
            return ParseError(p.c.line, p.c.col, "unterminated table header")
        }
        let segments = parse_key(mut p)?
        cursor_skip_spaces_comment(mut p.c)?
        let ch3 = cursor_peek(p.c)
        if ch3 != "]" {
            return ParseError(p.c.line, p.c.col, "expected ]")
        }
        cursor_advance(mut p.c)
        // Table header must be followed by newline or EOF
        require_newline_or_eof(mut p)?
        // Create intermediate tables for dotted keys
        let table_node = or_create_table_for_header(mut p, segments)?
        return Header { kind: 1, node: table_node }
    }
}

/// Require that the current position is at a newline, comment, or EOF.
fn require_newline_or_eof(mut p: Parser) -> () ! {ParseError(int, int, str)} {
    if cursor_at_end(p.c) {
        return
    }
    let ch = cursor_peek(p.c)
    if ch == "\n" || ch == "\r" {
        return
    }
    // Check for # comment (which extends to end of line)
    if ch == "#" {
        return
    }
    // Check for whitespace followed by newline/comment/EOF
    if ch == " " || ch == "\t" {
        // Skip only spaces and tabs, not newlines
        while !cursor_at_end(p.c) {
            let ch = cursor_peek(p.c)
            if ch == " " || ch == "\t" {
                cursor_advance(mut p.c)
            } else {
                break
            }
        }
        if cursor_at_end(p.c) {
            return
        }
        let ch2 = cursor_peek(p.c)
        if ch2 == "\n" || ch2 == "\r" || ch2 == "#" {
            return
        }
    }
    return ParseError(p.c.line, p.c.col, "key/value not followed by newline")
}

/// Create tables for each segment of a path, returning the final table.
/// Where a segment names an array of tables, resolve into its last element.
fn or_create_table_for_path(mut p: Parser, segments: List[str]) -> int ! {
    ParseError(int, int, str),
} {
    var current = 0 // root table
    var i = 0
    while i < segments.len {
        let segment = segments[i]
        current = or_resolve_segment(mut p, current, segment)?
        i = i + 1
    }
    current
}

/// Create tables for each segment of a [path] header, returning the final table.
/// Where a segment names an array of tables, resolve into its last element.
/// The final segment must name a table (not an array).
fn or_create_table_for_header(mut p: Parser, segments: List[str]) -> int ! {
    ParseError(int, int, str),
} {
    let n = segments.len
    var current = 0 // root table
    var i = 0
    while i < n - 1 {
        let segment = segments[i]
        may_define(p, current, segment, 1)?
        current = or_resolve_for_header(mut p, current, segment)?
        i = i + 1
    }
    // Last segment: must be a table, not an array
    let last = segments[n - 1]
    may_define(p, current, last, 3)?
    // If the table exists with defined_by 1, upgrade to 3
    let kid = find_child(p.arena, current, last) else -1
    if kid >= 0 {
        p.arena[kid].defined_by = 3
        return kid
    }
    let new_table = table_node(mut p.arena, 3, p.block)
    add_key(mut p.arena, current, last, new_table)
    new_table
}

/// Get or create a table child of parent with the given key. Returns error if key exists with wrong type.
fn or_create_table_in(mut p: Parser, parent: int, key: str) -> int ! {ParseError(int, int, str)} {
    let nkeys = node_key_len(p.arena, parent)
    var i = 0
    while i < nkeys {
        if node_key_at(p.arena, parent, i) == key {
            let kid = node_kid_at(p.arena, parent, i)
            let kind = node_kind(p.arena, kid)
            if kind == 0 {
                return kid
            }
            // Key exists but is not a table (could be an array or a value)
            return ParseError(p.c.line, p.c.col, "key already defined")
        }
        i = i + 1
    }
    let new_table = table_node(mut p.arena, 1, p.block)
    add_key(mut p.arena, parent, key, new_table)
    new_table
}

/// Get or create an array child of parent with the given key.
/// If the key already names an array of tables, return it (for appending).
/// If the key names a plain array or something else, refuse.
fn or_create_array_in(mut p: Parser, parent: int, key: str) -> int ! {ParseError(int, int, str)} {
    let nkeys = node_key_len(p.arena, parent)
    var i = 0
    while i < nkeys {
        if node_key_at(p.arena, parent, i) == key {
            let kid = node_kid_at(p.arena, parent, i)
            let kind = node_kind(p.arena, kid)
            if kind == 1 {
                // Already an array — check if it's an array of tables
                let nkids = node_kid_len(p.arena, kid)
                if nkids > 0 {
                    // Check if the first child is a table
                    let first = node_kid_at(p.arena, kid, 0)
                    let first_kind = node_kind(p.arena, first)
                    if first_kind != 0 {
                        // Not an array of tables
                        return ParseError(p.c.line, p.c.col, "key already defined")
                    }
                }
                // It's an array of tables (or empty) — return it for appending
                return kid
            }
            // Key exists but is not an array
            return ParseError(p.c.line, p.c.col, "key already defined")
        }
        i = i + 1
    }
    let new_array = array_node(mut p.arena)
    add_key(mut p.arena, parent, key, new_array)
    new_array
}

/// Create tables for each segment except the last, which is an array.
fn or_create_array_for_path(mut p: Parser, segments: List[str]) -> int ! {
    ParseError(int, int, str),
} {
    let n = segments.len
    if n == 0 {
        return ParseError(p.c.line, p.c.col, "empty key")
    }
    if n == 1 {
        // No intermediate tables, create array directly in root
        return or_create_array_in(mut p, 0, segments[0])?
    }
    // Create intermediate tables for all segments except the last
    var current = 0 // root table
    var i = 0
    while i < n - 1 {
        let segment = segments[i]
        let child = or_create_table_in(mut p, current, segment)?
        current = child
        i = i + 1
    }
    // Last segment is the array key
    or_create_array_in(mut p, current, segments[n - 1])?
}

/// Resolve a path for a [[...]] header: intermediate segments find or create tables
/// (resolving into the last element of arrays of tables), and the last segment
/// finds or creates an array of tables. Returns the array node.
fn or_resolve_array_for_path(mut p: Parser, segments: List[str]) -> int ! {
    ParseError(int, int, str),
} {
    let n = segments.len
    if n == 0 {
        return ParseError(p.c.line, p.c.col, "empty key")
    }
    var current = 0 // root table
    var i = 0
    while i < n - 1 {
        let segment = segments[i]
        may_define(p, current, segment, 1)?
        current = or_resolve_for_header(mut p, current, segment)?
        i = i + 1
    }
    // Last segment: find or create an array of tables
    may_define(p, current, segments[n - 1], 4)?
    or_create_array_in(mut p, current, segments[n - 1])?
}

/// Resolve a segment for a header: if it names a table, return it; if it names an array of tables,
/// return the last element; if it does not exist, create a table with defined_by 1.
fn or_resolve_for_header(mut p: Parser, parent: int, key: str) -> int ! {ParseError(int, int, str)} {
    let nkeys = node_key_len(p.arena, parent)
    var i = 0
    while i < nkeys {
        if node_key_at(p.arena, parent, i) == key {
            let kid = node_kid_at(p.arena, parent, i)
            let kind = node_kind(p.arena, kid)
            if kind == 0 {
                return kid
            }
            if kind == 1 {
                // It's an array — return its last element (must be a table)
                let nkids = node_kid_len(p.arena, kid)
                if nkids == 0 {
                    return ParseError(p.c.line, p.c.col, "key already defined")
                }
                let last = node_kid_at(p.arena, kid, nkids - 1)
                let last_kind = node_kind(p.arena, last)
                if last_kind != 0 {
                    return ParseError(p.c.line, p.c.col, "key already defined")
                }
                return last
            }
            // Key exists but is not a table or array
            return ParseError(p.c.line, p.c.col, "key already defined")
        }
        i = i + 1
    }
    // Key doesn't exist — create a table with defined_by 1
    let new_table = table_node(mut p.arena, 1, p.block)
    add_key(mut p.arena, parent, key, new_table)
    new_table
}

/// Resolve a segment: if it names a table, return it; if it names an array of tables,
/// return its last element; if it doesn't exist, create a table with defined_by 5.
fn or_resolve_segment(mut p: Parser, parent: int, key: str) -> int ! {ParseError(int, int, str)} {
    let nkeys = node_key_len(p.arena, parent)
    var i = 0
    while i < nkeys {
        if node_key_at(p.arena, parent, i) == key {
            let kid = node_kid_at(p.arena, parent, i)
            let kind = node_kind(p.arena, kid)
            if kind == 0 {
                // It's a table — return it
                return kid
            }
            if kind == 1 {
                // It's an array — return its last element (must be a table)
                let nkids = node_kid_len(p.arena, kid)
                if nkids == 0 {
                    return ParseError(p.c.line, p.c.col, "key already defined")
                }
                let last = node_kid_at(p.arena, kid, nkids - 1)
                let last_kind = node_kind(p.arena, last)
                if last_kind != 0 {
                    return ParseError(p.c.line, p.c.col, "key already defined")
                }
                return last
            }
            // Key exists but is not a table or array
            return ParseError(p.c.line, p.c.col, "key already defined")
        }
        i = i + 1
    }
    // Key doesn't exist — create a table
    let new_table = table_node(mut p.arena, 5, p.block)
    add_key(mut p.arena, parent, key, new_table)
    new_table
}

/// Parse a key (bare or quoted, possibly dotted). Returns the segments as a list.
fn parse_key(mut p: Parser) -> List[str] ! {ParseError(int, int, str)} {
    cursor_skip_spaces_comment(mut p.c)?
    let ch = cursor_peek(p.c)
    var result = List[str]()
    if ch == "\"" {
        let s = parse_key_string(mut p.c)?
        (mut result).push(s)
        cursor_skip_spaces(mut p.c)
        let ch2 = cursor_peek(p.c)
        if ch2 == "." {
            cursor_advance(mut p.c)
            let rest = parse_key(mut p)?
            var i = 0
            while i < rest.len {
                (mut result).push(rest[i])
                i = i + 1
            }
        }
        return result
    }
    if ch == "'" {
        let s = parse_key_string(mut p.c)?
        (mut result).push(s)
        cursor_skip_spaces(mut p.c)
        let ch2 = cursor_peek(p.c)
        if ch2 == "." {
            cursor_advance(mut p.c)
            let rest = parse_key(mut p)?
            var i = 0
            while i < rest.len {
                (mut result).push(rest[i])
                i = i + 1
            }
        }
        return result
    }
    var segment = ""
    while !cursor_at_end(p.c) {
        let ch = cursor_peek(p.c)
        if ch >= "a" && ch <= "z" ||
            ch >= "A" && ch <= "Z" ||
            ch >= "0" && ch <= "9" ||
            ch == "-" ||
            ch == "_" {
            segment = segment + ch
            cursor_advance(mut p.c)
        } else {
            break
        }
    }
    if segment == "" {
        return ParseError(p.c.line, p.c.col, "empty key")
    }
    (mut result).push(segment)
    cursor_skip_spaces(mut p.c)
    let ch2 = cursor_peek(p.c)
    if ch2 == "." {
        cursor_advance(mut p.c)
        let rest = parse_key(mut p)?
        var i = 0
        while i < rest.len {
            (mut result).push(rest[i])
            i = i + 1
        }
    }
    return result
}

/// Parse a key = value pair.
fn parse_key_value(mut p: Parser) -> int ! {ParseError(int, int, str)} {
    let segments = parse_key(mut p)?
    // Skip only spaces and tabs, not newlines
    cursor_skip_spaces(mut p.c)
    let ch = cursor_peek(p.c)
    if ch == "#" {
        // Comment: skip to end of line
        while !cursor_at_end(p.c) {
            let ch2 = cursor_peek(p.c)
            if ch2 == "\n" {
                break
            }
            if ch2 == "\r" {
                cursor_advance(mut p.c)
                let next = cursor_peek(p.c)
                if next == "\n" {
                    cursor_advance(mut p.c)
                }
                break
            }
            cursor_advance(mut p.c)
        }
        // After comment, must be at newline or EOF
        if !cursor_at_end(p.c) {
            let ch3 = cursor_peek(p.c)
            if ch3 != "\n" && ch3 != "\r" {
                return ParseError(p.c.line, p.c.col, "key not followed by =")
            }
        }
        // Now skip the newline
        let _ = cursor_skip_ws_comment(mut p.c)?
    }
    let ch = cursor_peek(p.c)
    if ch != "=" {
        return ParseError(p.c.line, p.c.col, "expected =")
    }
    cursor_advance(mut p.c)
    // Skip only spaces and tabs, not newlines
    cursor_skip_spaces(mut p.c)
    // Check for comment
    let ch = cursor_peek(p.c)
    if ch == "#" {
        // Skip to end of line
        while !cursor_at_end(p.c) {
            let ch2 = cursor_peek(p.c)
            if ch2 == "\n" {
                break
            }
            if ch2 == "\r" {
                cursor_advance(mut p.c)
                let next = cursor_peek(p.c)
                if next == "\n" {
                    cursor_advance(mut p.c)
                }
                break
            }
            cursor_advance(mut p.c)
        }
        // After comment, must be at newline or EOF
        if !cursor_at_end(p.c) {
            let ch3 = cursor_peek(p.c)
            if ch3 != "\n" && ch3 != "\r" {
                return ParseError(p.c.line, p.c.col, "= not followed by value")
            }
        }
        // Now skip the newline
        let _ = cursor_skip_ws_comment(mut p.c)?
    }
    let value_node = parse_value(mut p)?
    // Walk the segments: every segment but the last finds or creates a table
    add_key_for_segments(mut p, p.current, segments, value_node)?
    // Check that the value is followed by a newline, comment, or EOF
    require_newline_or_eof(mut p)?
    value_node
}

/// Add a key for a list of segments, descending through intermediate tables.
/// Where a segment names an array of tables, resolve into its last element.
fn add_key_for_segments(mut p: Parser, parent: int, segments: List[str], value_node: int) -> () ! {
    ParseError(int, int, str),
} {
    let n = segments.len
    if n == 0 {
        return ParseError(p.c.line, p.c.col, "empty key")
    }
    // Walk all segments except the last, descending through tables
    var current = parent
    var i = 0
    while i < n - 1 {
        let seg = segments[i]
        may_define(p, current, seg, 1)?
        current = or_resolve_segment(mut p, current, seg)?
        i = i + 1
    }
    // Last segment: add the value
    let last = segments[n - 1]
    may_define(p, current, last, 5)?
    add_key(mut p.arena, current, last, value_node)
}

/// Find the index of a child node by key.
fn find_child(arena: List[Node], parent: int, key: str) -> int ! {ParseError(int, int, str)} {
    let nkeys = node_key_len(arena, parent)
    var i = 0
    while i < nkeys {
        if node_key_at(arena, parent, i) == key {
            return node_kid_at(arena, parent, i)
        }
        i = i + 1
    }
    return -1
}

/// Decide whether a key may be defined in parent, and why not.
/// how: 1 dotted-key descent, 2 inline-table key, 3 [header], 4 [[header]], 5 plain key=value.
fn may_define(p: Parser, parent: int, key: str, how: int) -> () ! {ParseError(int, int, str)} {
    let kid = find_child(p.arena, parent, key) else -1
    if kid < 0 {
        // Key does not exist — always allowed
        return
    }
    let kind = node_kind(p.arena, kid)
    // Check closed BEFORE the kind checks, for tables and values alike
    // Closed tables (inline tables) refuse everything
    if p.arena[kid].closed {
        return ParseError(p.c.line, p.c.col, "inline table is closed")
    }
    // The key holds a value (not a table or array)
    if kind != 0 && kind != 1 {
        return ParseError(p.c.line, p.c.col, "key already defined")
    }
    // The key holds an array
    if kind == 1 {
        // how 3 ([header]) into an array is refused
        if how == 3 {
            return ParseError(p.c.line, p.c.col, "array of tables conflicts")
        }
        // how 5 (key=value) into an array is refused
        if how == 5 {
            return ParseError(p.c.line, p.c.col, "key already defined")
        }
        // how 4 ([[header]]) into an array: check if it's an array of tables or a value array
        if how == 4 {
            let defined_by = node_defined_by(p.arena, kid)
            // Value array (defined_by 2) — refuse
            if defined_by == 2 {
                return ParseError(p.c.line, p.c.col, "array of tables conflicts")
            }
            // Check if it's an array of tables
            let nkids = node_kid_len(p.arena, kid)
            if nkids == 0 {
                // Empty array — allow appending
                return
            }
            let first = node_kid_at(p.arena, kid, 0)
            let first_kind = node_kind(p.arena, first)
            if first_kind != 0 {
                return ParseError(p.c.line, p.c.col, "array of tables conflicts")
            }
            // It's an array of tables — allowed for appending
            return
        }
        // how 1 (dotted descent), 2 (inline) into an array: check if array of tables
        let nkids = node_kid_len(p.arena, kid)
        if nkids == 0 {
            return ParseError(p.c.line, p.c.col, "key already defined")
        }
        let first = node_kid_at(p.arena, kid, 0)
        let first_kind = node_kind(p.arena, first)
        if first_kind != 0 {
            return ParseError(p.c.line, p.c.col, "key already defined")
        }
        // It's an array of tables — allowed for descent
        return
    }
    // The key holds a table
    if kind == 0 {
        // Parent is closed and how is 3 or 4
        if p.arena[parent].closed && (how == 3 || how == 4) {
            return ParseError(p.c.line, p.c.col, "table is closed")
        }
        // how 3 or 4 and kid.defined_by == 5 → "table defined by dotted keys"
        if (how == 3 || how == 4) && node_defined_by(p.arena, kid) == 5 {
            return ParseError(p.c.line, p.c.col, "table defined by dotted keys")
        }
        // how 3 ([header]) into a table defined by 3 is refused
        if how == 3 && node_defined_by(p.arena, kid) == 3 {
            return ParseError(p.c.line, p.c.col, "table defined twice")
        }
        // how 4 ([[header]]) into a table is refused
        if how == 4 {
            return ParseError(p.c.line, p.c.col, "array of tables conflicts")
        }
        // how 5 (key=value) into a table is refused
        if how == 5 {
            return ParseError(p.c.line, p.c.col, "key already defined")
        }
        return
    }
    return ParseError(p.c.line, p.c.col, "key already defined")
}

/// Parse a value.
fn parse_value(mut p: Parser) -> int ! {ParseError(int, int, str)} {
    let kind = peek_value_kind(p.c)
    if kind == "string" {
        let s = parse_string(mut p.c)?
        return string_node(mut p.arena, s)
    }
    if kind == "integer" {
        let v = parse_integer(mut p.c)?
        return int_node(mut p.arena, v)
    }
    if kind == "float" {
        let v = parse_float(mut p.c)?
        return float_node(mut p.arena, v)
    }
    if kind == "bool" {
        let v = parse_boolean(mut p.c)?
        let b = v == "true"
        return bool_node(mut p.arena, b)
    }
    if kind == "datetime" {
        let v = parse_datetime(mut p.c)?
        // Check if it has an offset (ends with Z, +HH:MM, or -HH:MM)
        let has_offset = has_timezone(v)
        let kind = if has_offset { 6 } else { 7 }
        return datetime_node(mut p.arena, v, kind)
    }
    if kind == "local-date" {
        let v = parse_local_date(mut p.c)?
        return datetime_node(mut p.arena, v, 8)
    }
    if kind == "local-time" {
        let v = parse_local_time(mut p.c)?
        return datetime_node(mut p.arena, v, 9)
    }
    let ch = cursor_peek(p.c)
    if ch == "[" {
        return parse_array(mut p)?
    }
    if ch == "{{" {
        return parse_inline_table(mut p)?
    }
    return ParseError(p.c.line, p.c.col, "unexpected value")
}

/// Parse an array.
fn parse_array(mut p: Parser) -> int ! {ParseError(int, int, str)} {
    let ch = cursor_peek(p.c)
    if ch != "[" {
        return ParseError(p.c.line, p.c.col, "expected [")
    }
    cursor_advance(mut p.c)
    let arr_node = array_node(mut p.arena)
    p.arena[arr_node].defined_by = 2
    cursor_skip_ws_comment(mut p.c)?
    let ch2 = cursor_peek(p.c)
    if ch2 == "]" {
        cursor_advance(mut p.c)
        return arr_node
    }
    while !cursor_at_end(p.c) {
        let value_node = parse_value(mut p)?
        add_child(mut p.arena, arr_node, value_node)
        cursor_skip_ws_comment(mut p.c)?
        let ch3 = cursor_peek(p.c)
        if ch3 == "]" {
            cursor_advance(mut p.c)
            return arr_node
        }
        if ch3 == "," {
            cursor_advance(mut p.c)
            cursor_skip_ws_comment(mut p.c)?
            let ch4 = cursor_peek(p.c)
            if ch4 == "]" {
                cursor_advance(mut p.c)
                return arr_node
            }
        } else {
            return ParseError(p.c.line, p.c.col, "expected , or ]")
        }
    }
    return ParseError(p.c.line, p.c.col, "unexpected end of array")
}

/// Parse an inline table.
fn parse_inline_table(mut p: Parser) -> int ! {ParseError(int, int, str)} {
    let ch = cursor_peek(p.c)
    if ch != "{{" {
        return ParseError(p.c.line, p.c.col, "expected {{")
    }
    cursor_advance(mut p.c)
    let table_node = table_node(mut p.arena, 2, p.block)
    // Skip only spaces and tabs, not newlines
    cursor_skip_spaces(mut p.c)
    let ch2 = cursor_peek(p.c)
    if ch2 == "}}" {
        cursor_advance(mut p.c)
        close_table(mut p.arena, table_node)
        return table_node
    }
    while !cursor_at_end(p.c) {
        // Check for newline before key
        let ch_before = cursor_peek(p.c)
        if ch_before == "\n" || ch_before == "\r" {
            return ParseError(p.c.line, p.c.col, "newline in inline table")
        }
        let segments = parse_key(mut p)?
        // Skip only spaces and tabs, not newlines
        cursor_skip_spaces(mut p.c)
        let ch3 = cursor_peek(p.c)
        if ch3 != "=" {
            return ParseError(p.c.line, p.c.col, "expected =")
        }
        cursor_advance(mut p.c)
        // Skip only spaces and tabs, not newlines
        cursor_skip_spaces(mut p.c)
        let value_node = parse_value(mut p)?
        add_key_for_segments(mut p, table_node, segments, value_node)?
        // Skip only spaces and tabs, not newlines
        cursor_skip_spaces(mut p.c)
        let ch4 = cursor_peek(p.c)
        if ch4 == "}}" {
            cursor_advance(mut p.c)
            close_table(mut p.arena, table_node)
            return table_node
        }
        if ch4 == "," {
            cursor_advance(mut p.c)
            // Skip only spaces and tabs, not newlines
            cursor_skip_spaces(mut p.c)
            let ch5 = cursor_peek(p.c)
            if ch5 == "}}" {
                return ParseError(p.c.line, p.c.col, "trailing comma in inline table")
            }
            // Check for newline after comma
            if ch5 == "\n" || ch5 == "\r" {
                return ParseError(p.c.line, p.c.col, "newline in inline table")
            }
        } else {
            return ParseError(p.c.line, p.c.col, "expected , or }}")
        }
    }
    return ParseError(p.c.line, p.c.col, "unexpected end of inline table")
}

/// Get or create a table for a key.
fn or_create_table(mut p: Parser, key: str) -> int {
    let existing = p.tables.get(key) else -1
    if existing >= 0 {
        return existing
    }
    let new_table = table_node(mut p.arena, 1, p.block)
    (mut p.tables).set(key, new_table)
    new_table
}

/// Get or create an array for a key.
fn or_create_array(mut p: Parser, key: str) -> int {
    let existing = p.arrays.get(key) else -1
    if existing >= 0 {
        return existing
    }
    let new_array = array_node(mut p.arena)
    (mut p.arrays).set(key, new_array)
    new_array
}

fn parser_main() -> !int {
    let text = "a = 1\n[b]\nc = 2"
    var p = parser_init(text)
    let root = parse_document(mut p) else |err| {
        print("error: {err}")
        return 1
    }
    print("root kind: {node_kind(p.arena, root)}")
    0
}
