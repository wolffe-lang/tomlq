//! check: run(exit=0)

/// Emit a node as plain JSON.
fn emit_json(arena: List[Node], i: int) -> str ! {ParseError(int, int, str)} {
    var b = sink_new()
    emit_json_node(mut b, arena, i)?
    sink_text(b)
}

/// Emit a node as plain JSON into a sink.
fn emit_json_node(mut b: Sink, arena: List[Node], i: int) -> () ! {ParseError(int, int, str)} {
    let kind = node_kind(arena, i)
    if kind == 0 {
        emit_json_table(mut b, arena, i)?
    } else if kind == 1 {
        emit_json_array(mut b, arena, i)?
    } else if kind == 2 {
        emit_json_string(mut b, node_str(arena, i))
    } else if kind == 3 {
        sink_push(mut b, "{node_int(arena, i)}")
    } else if kind == 4 {
        emit_json_float_value(mut b, node_float(arena, i))
    } else if kind == 5 {
        if node_bool(arena, i) {
            sink_push(mut b, "true")
        } else {
            sink_push(mut b, "false")
        }
    } else if kind >= 6 && kind <= 9 {
        emit_json_string(mut b, node_str(arena, i))
    }
}

/// Emit a table as JSON.
fn emit_json_table(mut b: Sink, arena: List[Node], i: int) -> () ! {ParseError(int, int, str)} {
    sink_push(mut b, "{{")
    let nkeys = node_key_len(arena, i)
    var first = true
    var j = 0
    while j < nkeys {
        if !first {
            sink_push(mut b, ",")
        }
        first = false
        emit_json_string(mut b, node_key_at(arena, i, j))
        sink_push(mut b, ":")
        emit_json_node(mut b, arena, node_kid_at(arena, i, j))?
        j = j + 1
    }
    sink_push(mut b, "}}")
}

/// Emit an array as JSON.
fn emit_json_array(mut b: Sink, arena: List[Node], i: int) -> () ! {ParseError(int, int, str)} {
    sink_push(mut b, "[")
    let nkids = node_kid_len(arena, i)
    var first = true
    var j = 0
    while j < nkids {
        if !first {
            sink_push(mut b, ",")
        }
        first = false
        emit_json_node(mut b, arena, node_kid_at(arena, i, j))?
        j = j + 1
    }
    sink_push(mut b, "]")
}

/// Emit a string as JSON.
fn emit_json_string(mut b: Sink, s: str) {
    sink_push(mut b, "\"")
    var i = 0
    while i < s.len {
        let ch = char_at(s, i)
        if ch == "" {
            i = i + 1
        } else {
            i = i + ch.len
        }
        if ch == "\"" {
            sink_push(mut b, "\\\"")
        } else if ch == "\\" {
            sink_push(mut b, "\\\\")
        } else if ch == "\n" {
            sink_push(mut b, "\\n")
        } else if ch == "\r" {
            sink_push(mut b, "\\r")
        } else if ch == "\t" {
            sink_push(mut b, "\\t")
        } else if ch == "\x08" {
            sink_push(mut b, "\\b")
        } else if ch == "\x0C" {
            sink_push(mut b, "\\f")
        } else if ch.len == 1 && (ch < " " || ch == "\x7F") {
            sink_push(mut b, json_control(ch))
        } else {
            sink_push(mut b, ch)
        }
    }
    sink_push(mut b, "\"")
}

/// `\u00XX` for a control character (one byte below 0x20, or 0x7F).
fn json_control(ch: str) -> str {
    let v = ch.bytes()[0] as int
    let hex = "0123456789abcdef"
    let hi = hex.get(v / 16..v / 16 + 1) else "0"
    let lo = hex.get(v % 16..v % 16 + 1) else "0"
    "\\u00" + hi + lo
}

/// Emit a float as JSON.
fn emit_json_float(mut b: Sink, f: f64) {
    sink_push(mut b, "{f}")
}

/// Emit a float value as JSON: a number, or a string for inf/nan.
fn emit_json_float_value(mut b: Sink, f: f64) {
    // Check for inf/nan
    if f != f {
        // NaN
        sink_push(mut b, "\"nan\"")
        return
    }
    if f == 1.0 / 0.0 {
        sink_push(mut b, "\"inf\"")
        return
    }
    if f == -1.0 / 0.0 {
        sink_push(mut b, "\"-inf\"")
        return
    }
    // Regular float: print with "{v}" and add .0 if needed
    let s = "{f}"
    if !s.contains(".") && !s.contains("e") && !s.contains("E") {
        sink_push(mut b, "{s}.0")
    } else {
        sink_push(mut b, s)
    }
}

/// Emit a node as tagged JSON (corpus style).
fn emit_tagged(arena: List[Node], i: int) -> str ! {ParseError(int, int, str)} {
    var b = sink_new()
    emit_tagged_node(mut b, arena, i)?
    sink_text(b)
}

/// Emit a node as tagged JSON into a sink.
fn emit_tagged_node(mut b: Sink, arena: List[Node], i: int) -> () ! {ParseError(int, int, str)} {
    let kind = node_kind(arena, i)
    if kind == 0 {
        emit_tagged_table(mut b, arena, i)?
    } else if kind == 1 {
        emit_tagged_array(mut b, arena, i)?
    } else if kind == 2 {
        emit_tagged_value(mut b, "string", node_str(arena, i))
    } else if kind == 3 {
        emit_tagged_value(mut b, "integer", "{node_int(arena, i)}")
    } else if kind == 4 {
        emit_tagged_float_value(mut b, node_float(arena, i))
    } else if kind == 5 {
        if node_bool(arena, i) {
            emit_tagged_value(mut b, "bool", "true")
        } else {
            emit_tagged_value(mut b, "bool", "false")
        }
    } else if kind == 6 {
        emit_tagged_value(mut b, "datetime", node_str(arena, i))
    } else if kind == 7 {
        emit_tagged_value(mut b, "datetime-local", node_str(arena, i))
    } else if kind == 8 {
        emit_tagged_value(mut b, "date-local", node_str(arena, i))
    } else if kind == 9 {
        emit_tagged_value(mut b, "time-local", node_str(arena, i))
    }
}

/// Emit a tagged value: {"type": T, "value": V}
fn emit_tagged_value(mut b: Sink, t: str, v: str) {
    sink_push(mut b, "{{\"type\":")
    emit_json_string(mut b, t)
    sink_push(mut b, ",\"value\":")
    emit_json_string(mut b, v)
    sink_push(mut b, "}}")
}

/// Emit a float as tagged JSON.
fn emit_tagged_float_value(mut b: Sink, f: f64) {
    sink_push(mut b, "{{\"type\":\"float\",\"value\":\"")
    // Check for inf/nan
    if f != f {
        sink_push(mut b, "nan")
    } else if f == 1.0 / 0.0 {
        sink_push(mut b, "inf")
    } else if f == -1.0 / 0.0 {
        sink_push(mut b, "-inf")
    } else {
        sink_push(mut b, "{f}")
    }
    sink_push(mut b, "\"}}")
}

/// Emit a table as tagged JSON.
fn emit_tagged_table(mut b: Sink, arena: List[Node], i: int) -> () ! {ParseError(int, int, str)} {
    sink_push(mut b, "{{")
    let nkeys = node_key_len(arena, i)
    var first = true
    var j = 0
    while j < nkeys {
        if !first {
            sink_push(mut b, ",")
        }
        first = false
        emit_json_string(mut b, node_key_at(arena, i, j))
        sink_push(mut b, ":")
        emit_tagged_node(mut b, arena, node_kid_at(arena, i, j))?
        j = j + 1
    }
    sink_push(mut b, "}}")
}

/// Emit an array as tagged JSON.
fn emit_tagged_array(mut b: Sink, arena: List[Node], i: int) -> () ! {ParseError(int, int, str)} {
    sink_push(mut b, "[")
    let nkids = node_kid_len(arena, i)
    var first = true
    var j = 0
    while j < nkids {
        if !first {
            sink_push(mut b, ",")
        }
        first = false
        emit_tagged_node(mut b, arena, node_kid_at(arena, i, j))?
        j = j + 1
    }
    sink_push(mut b, "]")
}

fn emit_main() -> !int ! {ParseError(int, int, str)} {
    var arena = List[Node]()
    let root = table_node(mut arena, 0)
    let s = string_node(mut arena, "hello")
    add_key(mut arena, root, "key", s)
    let j = emit_json(arena, root)?
    print("json: {j}")
    0
}
