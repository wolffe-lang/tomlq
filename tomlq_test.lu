//! check: run(exit=0)

fn test_main() -> !int {
    // Test that the parser can parse a simple TOML file
    let text = "a = 1\nb = \"hello\"\nc = true"
    var p = parser_init(text)
    let root = parse_document(mut p) else |e| {
        print("parse failed: {e}")
        return 1
    }
    // Test that we can navigate the tree
    let a_node = navigate_path(p.arena, root, "a")
    if a_node < 0 {
        print("navigate failed")
        return 1
    }
    // Test that we can emit JSON
    let j = emit_json(p.arena, root) else |e| {
        print("emit failed: {e}")
        return 1
    }
    print("json: {j}")
    0
}

/// The plain JSON of a small document, or "ERR: ..." when it is refused.
fn json_of(text: str) -> str {
    var p = parser_init(text)
    let root = parse_document(mut p) else |e| {
        return "ERR: {e}"
    }
    emit_json(p.arena, root) else |e| {
        "ERR: {e}"
    }
}

/// 0 when `got` is `want`; otherwise prints both and returns 1.
fn expect(name: str, got: str, want: str) -> int {
    if got == want {
        return 0
    }
    print("{name}: got [{got}] want [{want}]")
    1
}

fn test_strings_decode_as_utf8() -> !int {
    var bad = 0
    bad = bad + expect("escaped e-acute", json_of("a = \"\\u00e9\""), "{{\"a\":\"é\"}}")
    bad = bad + expect("escaped emoji", json_of("a = \"\\U0001F600\""), "{{\"a\":\"😀\"}}")
    bad = bad + expect("literal multibyte", json_of("a = \"ɑ€𐫱\""), "{{\"a\":\"ɑ€𐫱\"}}")
    bad = bad + expect("literal string", json_of("a = 'é'"), "{{\"a\":\"é\"}}")
    bad = bad + expect("unicode keys", json_of("\"μ\" = 1\n\"Μ\" = 2"), "{{\"μ\":1,\"Μ\":2}}")
    bad
}

fn test_bad_code_points_are_refused() -> !int {
    var bad = 0
    if !json_of("a = \"\\uD800\"").starts_with("ERR") {
        print("a surrogate was accepted")
        bad = bad + 1
    }
    if !json_of("a = \"\\U00110000\"").starts_with("ERR") {
        print("a code point past 10FFFF was accepted")
        bad = bad + 1
    }
    bad
}

fn test_json_escapes_control_characters() -> !int {
    expect(
        "controls",
        json_of("a = \"\\b\\f\\u0001\\u001F\\u007F\""),
        "{{\"a\":\"\\b\\f\\u0001\\u001f\\u007f\"}}",
    )
}

fn test_line_ending_backslash_trims_whitespace() -> !int {
    var bad = 0
    bad = bad +
        expect("to the next character", json_of("a = \"\"\"\\\n    x\"\"\""), "{{\"a\":\"x\"}}")
    bad = bad +
        expect(
            "spaces after the backslash",
            json_of("a = \"\"\"a\\  \n\n  b\"\"\""),
            "{{\"a\":\"ab\"}}",
        )
    bad = bad + expect("the first newline", json_of("a = \"\"\"\nx\"\"\""), "{{\"a\":\"x\"}}")
    bad
}

fn test_dotted_keys_create_tables() -> !int {
    var bad = 0
    // a.b.c = 1 makes tables a and a.b
    bad = bad + expect("three segments", json_of("a.b.c = 1"), "{{\"a\":{{\"b\":{{\"c\":1}}}}}}")
    // a.b = 1 then a.c = 2 share table a
    bad = bad +
        expect("shared parent", json_of("a.b = 1\na.c = 2"), "{{\"a\":{{\"b\":1,\"c\":2}}}}")
    // "a.b" = 1 is one key (quoted segment)
    bad = bad + expect("quoted dot", json_of("\"a.b\" = 1"), "{{\"a.b\":1}}")
    // a . b = 1 (spaces around the dot) equals a.b = 1
    bad = bad + expect("spaces around dot", json_of("a . b = 1"), "{{\"a\":{{\"b\":1}}}}")
    // [x."y.z"] opens table y.z inside x
    bad = bad +
        expect(
            "table header quoted",
            json_of("[x.\"y.z\"]\nk = 1"),
            "{{\"x\":{{\"y.z\":{{\"k\":1}}}}}}",
        )
    // a.b = 1 then a.b = 2 is refused
    if !json_of("a.b = 1\na.b = 2").starts_with("ERR") {
        print("duplicate dotted key was accepted")
        bad = bad + 1
    }
    // a = 1 then a.b = 2 is refused
    if !json_of("a = 1\na.b = 2").starts_with("ERR") {
        print("scalar then dotted key was accepted")
        bad = bad + 1
    }
    bad
}

fn test_arrays_of_tables() -> !int {
    var bad = 0
    // [[s]] twice makes an array of two tables
    bad = bad +
        expect(
            "two elements",
            json_of("[[s]]\na = 1\n[[s]]\na = 2"),
            "{{\"s\":[{{\"a\":1}},{{\"a\":2}}]}}",
        )
    // [[s]] then [s.t] puts t in the LAST element
    bad = bad +
        expect(
            "subtable in last",
            json_of("[[s]]\n[s.t]\nx = 1"),
            "{{\"s\":[{{\"t\":{{\"x\":1}}}}]}}",
        )
    // [[a]], [[a.b]], [[a]], [[a.b]] makes a = two tables each holding a one-element b
    bad = bad +
        expect(
            "nested arrays",
            json_of("[[a]]\n[[a.b]]\nx = 1\n[[a]]\n[[a.b]]\ny = 2"),
            "{{\"a\":[{{\"b\":[{{\"x\":1}}]}},{{\"b\":[{{\"y\":2}}]}}]}}",
        )
    // x.y = 1 under [[s]] lands in the last element
    bad = bad +
        expect(
            "dotted key in array",
            json_of("[[s]]\nx.y = 1"),
            "{{\"s\":[{{\"x\":{{\"y\":1}}}}]}}",
        )
    // a = [1] then [[a]] is refused
    if !json_of("a = [1]\n[[a]]").starts_with("ERR") {
        print("plain array then [[a]] was accepted")
        bad = bad + 1
    }
    // [a] then [[a]] is refused
    if !json_of("[a]\n[[a]]").starts_with("ERR") {
        print("table then [[a]] was accepted")
        bad = bad + 1
    }
    // [[a]] then [a] is refused
    if !json_of("[[a]]\n[a]").starts_with("ERR") {
        print("[[a]] then [a] was accepted")
        bad = bad + 1
    }
    bad
}

/// The plain JSON of a small document, or "ERR: ..." when it is refused.
fn tagged_of(text: str) -> str {
    var p = parser_init(text)
    let root = parse_document(mut p) else |e| {
        return "ERR: {e}"
    }
    emit_tagged(p.arena, root) else |e| {
        "ERR: {e}"
    }
}

fn test_integers_as_values() -> !int {
    var bad = 0
    // 0xDEADBEEF → 3735928559
    bad = bad + expect("hex", json_of("a = 0xDEADBEEF"), "{{\"a\":3735928559}}")
    // 0o755 → 493
    bad = bad + expect("octal", json_of("a = 0o755"), "{{\"a\":493}}")
    // 0b11010110 → 214
    bad = bad + expect("binary", json_of("a = 0b11010110"), "{{\"a\":214}}")
    // 1_000 → 1000
    bad = bad + expect("underscore", json_of("a = 1_000"), "{{\"a\":1000}}")
    // +99 → 99
    bad = bad + expect("plus sign", json_of("a = +99"), "{{\"a\":99}}")
    // -0 → 0
    bad = bad + expect("neg zero", json_of("a = -0"), "{{\"a\":0}}")
    // 9223372036854775807 accepted
    bad = bad +
        expect("max int", json_of("a = 9223372036854775807"), "{{\"a\":9223372036854775807}}")
    // 9223372036854775808 refused
    if !json_of("a = 9223372036854775808").starts_with("ERR") {
        print("overflowing integer was accepted")
        bad = bad + 1
    }
    // 0X1 refused (uppercase prefix)
    if !json_of("a = 0X1").starts_with("ERR") {
        print("0X1 was accepted")
        bad = bad + 1
    }
    // 0O1 refused
    if !json_of("a = 0O1").starts_with("ERR") {
        print("0O1 was accepted")
        bad = bad + 1
    }
    // 0B1 refused
    if !json_of("a = 0B1").starts_with("ERR") {
        print("0B1 was accepted")
        bad = bad + 1
    }
    // +0x1 refused (sign on non-decimal)
    if !json_of("a = +0x1").starts_with("ERR") {
        print("+0x1 was accepted")
        bad = bad + 1
    }
    // 01 refused (leading zero)
    if !json_of("a = 01").starts_with("ERR") {
        print("01 was accepted")
        bad = bad + 1
    }
    // 1__0 refused (double underscore)
    if !json_of("a = 1__0").starts_with("ERR") {
        print("1__0 was accepted")
        bad = bad + 1
    }
    // _1 refused (leading underscore)
    if !json_of("a = _1").starts_with("ERR") {
        print("_1 was accepted")
        bad = bad + 1
    }
    // 1_ refused (trailing underscore)
    if !json_of("a = 1_").starts_with("ERR") {
        print("1_ was accepted")
        bad = bad + 1
    }
    bad
}

fn test_floats_as_values() -> !int {
    var bad = 0
    // 1e2 → tagged 100, JSON 100.0
    bad = bad + expect("1e2 json", json_of("a = 1e2"), "{{\"a\":100.0}}")
    bad = bad +
        expect(
            "1e2 tagged",
            tagged_of("a = 1e2"),
            "{{\"a\":{{{{\"type\":\"float\",\"value\":\"100\"}}}}}}",
        )
    // 3.1e2 → 310/310.0
    bad = bad + expect("3.1e2 json", json_of("a = 3.1e2"), "{{\"a\":310.0}}")
    // -0.1 → -0.1
    bad = bad + expect("neg float", json_of("a = -0.1"), "{{\"a\":-0.1}}")
    // 1_0.5 → 10.5
    bad = bad + expect("underscore float", json_of("a = 1_0.5"), "{{\"a\":10.5}}")
    // +0e2 → 0/0.0
    bad = bad + expect("+0e2 json", json_of("a = +0e2"), "{{\"a\":0.0}}")
    // -inf → tagged -inf, JSON "-inf"
    bad = bad + expect("-inf json", json_of("a = -inf"), "{{\"a\":\"-inf\"}}")
    bad = bad +
        expect(
            "-inf tagged",
            tagged_of("a = -inf"),
            "{{\"a\":{{{{\"type\":\"float\",\"value\":\"-inf\"}}}}}}",
        )
    // nan → tagged nan, JSON "nan"
    bad = bad + expect("nan json", json_of("a = nan"), "{{\"a\":\"nan\"}}")
    bad = bad +
        expect(
            "nan tagged",
            tagged_of("a = nan"),
            "{{\"a\":{{{{\"type\":\"float\",\"value\":\"nan\"}}}}}}",
        )
    // .5 refused
    if !json_of("a = .5").starts_with("ERR") {
        print(".5 was accepted")
        bad = bad + 1
    }
    // 1. refused
    if !json_of("a = 1.").starts_with("ERR") {
        print("1. was accepted")
        bad = bad + 1
    }
    // -.5 refused
    if !json_of("a = -.5").starts_with("ERR") {
        print("-.5 was accepted")
        bad = bad + 1
    }
    // 01.5 refused
    if !json_of("a = 01.5").starts_with("ERR") {
        print("01.5 was accepted")
        bad = bad + 1
    }
    // 1e refused
    if !json_of("a = 1e").starts_with("ERR") {
        print("1e was accepted")
        bad = bad + 1
    }
    // 1.e2 refused
    if !json_of("a = 1.e2").starts_with("ERR") {
        print("1.e2 was accepted")
        bad = bad + 1
    }
    // 1__0.5 refused
    if !json_of("a = 1__0.5").starts_with("ERR") {
        print("1__0.5 was accepted")
        bad = bad + 1
    }
    bad
}
